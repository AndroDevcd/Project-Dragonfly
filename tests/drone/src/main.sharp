mod main;

import ( std, std.testing, link, link.hardware, link.protocol, link.messages, drone, drone.hardware );

/**
 * THE DRONE, TESTED ON A PC
 *
 * The real flight computer runs against fake hardware; "the controller" is a
 * second link on the other end of a fake radio. Time is the test's own clock.
 *
 *      sharpc -P tests/drone       then        sharp tests/drone/build/outputs/drone_tests
 */
class bench {
    air := new radio_pair();
    time := new fake_clock();
    ground := new fake_distance_sensor();
    thrust := new fake_motors();
    power := new fake_battery();
    computer : flight_computer;
    controller : radio_link;                // the other end

    bench() {
        time.advance(1000);
        computer = new flight_computer(new drone_devices(air.second, time, ground, thrust, power));
        controller = new radio_link(air.first, time);
    }

    def run(rounds: _int64, ms: _int64) {
        for(i : _int64 = 0; i < rounds; i++) {
            controller.step();
            computer.step();
            time.advance(ms);
        }
    }

    def connect() {
        controller.connect();
        run(10, 5);
    }

    /** the newest message of this kind the controller received (older ones are dropped); null when none */
    def heard(type: _int64) : message? {
        found : message? = null;
        for(;;) {
            m := controller.next();
            if(m == null) { return found; }
            if(m!!.type == type) { found = m; }
        }
        return found;
    }
}

def test_failsafe_before_contact() {
    tests("before any controller is heard") {
        t := new bench();
        t.run(20, 10);
        test("the failsafe is on") { expect_true(t.computer.state.failsafe); };
        test("the motors get the failsafe throttle") { expect(t.thrust.throttle).should_be(FAILSAFE_THROTTLE); };
        test("no telemetry is sent into the void") { expect(t.computer.state.telemetry_sent).should_be(0); };
    };
}

def test_mode_and_sticks() {
    tests("mode and sticks") {
        t := new bench();
        t.connect();
        test("connected: the failsafe is off") { expect_true(!t.computer.state.failsafe); };

        t.controller.publish(new steer(600, 0 - 400, 200, 0).to_message());
        t.run(4, 5);
        test("normal mode obeys the sticks half way: throttle") { expect(t.thrust.throttle).should_be(300); };
        test("... yaw") { expect(t.thrust.yaw).should_be(0 - 200); };
        test("... pitch") { expect(t.thrust.pitch).should_be(100); };

        id := t.controller.send(new set_mode(MODE_SPORT).to_message());
        t.run(4, 5);
        test("the mode change was acknowledged") { expect_true(t.controller.is_delivered(id)); };
        test("the drone is in sport mode") { expect(t.computer.state.mode).should_be(MODE_SPORT); };
        t.controller.publish(new steer(600, 0 - 400, 200, 0).to_message());
        t.run(4, 5);
        test("sport mode obeys the sticks fully") { expect(t.thrust.throttle).should_be(600); };

        // a controller that stops steering must not leave the last command running
        t.run(80, 10);                              // 800 ms without a steer message (heartbeats keep the link up)
        test("still connected") { expect_true(t.computer.state.connected); };
        test("stale sticks count as centred") { expect(t.thrust.throttle).should_be(0); };
    };
}

def test_telemetry() {
    tests("telemetry") {
        t := new bench();
        t.connect();
        t.ground.cm = 120;
        t.power.bars = 2;
        t.run(60, 10);
        reading := t.heard(message_types.TELEMETRY);
        test("telemetry arrives") { expect_true(reading != null); };
        if(reading != null) {
            read := telemetry.from_message(reading!!);
            test("it decodes") { expect_true(read != null); };
            if(read != null) {
                test("the altitude") { expect(read!!.altitude_cm).should_be(120); };
                test("the battery") { expect(read!!.battery).should_be(2); };
                test("the mode") { expect(read!!.mode).should_be(MODE_NORMAL); };
            }
        }
        test("about five a second") { expect_true(t.computer.state.telemetry_sent >= 2 && t.computer.state.telemetry_sent <= 5); };

        // climbing 50 cm in half a second is 100 cm/s
        t.ground.cm = 170;
        t.run(50, 10);
        climbing := t.heard(message_types.TELEMETRY);
        test("the speed follows the height") { expect_true(climbing != null && telemetry.from_message(climbing!!)!!.altitude_cm == 170); };
    };
}

def test_altimeter() {
    tests("the altimeter reads more often near the ground") {
        time := new fake_clock();
        time.advance(1000);
        sensor := new fake_distance_sensor();
        meter := new altimeter(sensor, time);
        sensor.cm = 100;
        meter.step();
        test("near the ground") { expect(meter.interval_ms()).should_be(NEAR_INTERVAL_MS); };
        sensor.cm = 200;
        time.advance(100);
        meter.step();
        test("in the middle") { expect(meter.interval_ms()).should_be(MIDDLE_INTERVAL_MS); };
        test("it climbed 100 cm in 100 ms: 1000 cm/s") { expect(meter.climb_cm_s).should_be(1000); };
        sensor.cm = 500;
        time.advance(150);
        meter.step();
        test("high up") { expect(meter.interval_ms()).should_be(FAR_INTERVAL_MS); };

        reads : _int64 = sensor.reads;
        time.advance(100);
        meter.step();
        test("not read again before it is due") { expect(sensor.reads).should_be(reads); };

        sensor.cm = 0 - 1;
        time.advance(250);
        meter.step();
        test("no echo: no ground") { expect_true(!meter.has_ground); };
        test("the last good height is kept") { expect(meter.altitude_cm).should_be(500); };
    };
}

/** told to stop (q at the console): the motors are stopped, whatever the sticks said */
def test_shutting_down() {
    tests("shutting down") {
        t := new bench();
        t.connect();
        t.controller.publish(new steer(600, 100, 0, 0).to_message());
        t.run(4, 5);
        test("flying: the motors are driven") { expect_true(t.thrust.throttle > 0); };
        t.computer.shut_down();
        test("stopped: throttle") { expect(t.thrust.throttle).should_be(0); };
        test("stopped: yaw") { expect(t.thrust.yaw).should_be(0); };
    };
}

def test_losing_the_controller() {
    tests("losing the controller") {
        t := new bench();
        t.connect();
        t.controller.publish(new steer(800, 0, 0, 0).to_message());
        t.run(4, 5);
        test("flying on the sticks") { expect_true(t.thrust.throttle > 0 && !t.computer.state.failsafe); };

        t.air.first.set_blocked(true);
        t.air.second.set_blocked(true);
        t.run(200, 10);                             // two seconds out of range
        test("the failsafe is on") { expect_true(t.computer.state.failsafe); };
        test("the motors get the failsafe throttle, not the last stick") { expect(t.thrust.throttle).should_be(FAILSAFE_THROTTLE); };
        test("and nothing else") { expect(t.thrust.yaw + t.thrust.pitch + t.thrust.roll).should_be(0); };
        test("it was counted") { expect(t.computer.state.failsafe_count).should_be(1); };

        t.air.first.set_blocked(false);
        t.air.second.set_blocked(false);
        t.run(100, 10);
        test("back in range: the failsafe is off") { expect_true(!t.computer.state.failsafe); };
        test("the old stick position did not come back by itself") { expect(t.thrust.throttle).should_be(0); };
        told := t.heard(message_types.NOTICE);
        test("the pilot is told the link is back") { expect_true(told != null && notice.from_message(told!!)!!.text == "link restored"); };
    };
}

/** a jammer that remembers the channel it was asked for */
class recording_jammer : radio_control {
    channel : _int64 = 0 - 1;
    override def set_power(level: _int64) { }
    override def jam(channel: _int64) { self->channel = channel; }
}

def test_jam_and_unknown() {
    tests("jam, and a message the drone does not know") {
        t := new bench();
        t.connect();
        t.controller.send(new jam(40).to_message());
        t.run(20, 5);
        refused := t.heard(message_types.NOTICE);
        test("a drone without a jammer says so") { expect_true(refused != null && notice.from_message(refused!!)!!.level == NOTICE_WARNING); };

        jammer := new recording_jammer();
        t.computer.set_jammer(jammer);
        t.controller.send(new jam(77).to_message());
        t.run(20, 5);
        test("the jammer got the channel") { expect(jammer.channel).should_be(77); };
        done := t.heard(message_types.NOTICE);
        test("and the pilot is told") { expect_true(done != null && notice.from_message(done!!)!!.text == "jammed channel 77"); };

        t.controller.send(new message(99));
        t.run(20, 5);
        unknown := t.heard(message_types.NOTICE);
        test("an unknown message is answered, not swallowed") { expect_true(unknown != null); };
    };
}

/**
 * The drone on MOCK devices. The fakes above are small working devices: a
 * test sets `ground.cm` and looks at `thrust.throttle` afterwards. These
 * tests ask the other question - what did the flight computer ASK of its
 * devices? - which only something that watches the calls can answer.
 * Nothing is written for the mocks: mock<motors>() and friends.
 */
def test_what_the_drone_asks_of_its_devices() {
    tests("the drone on mock devices: what it asks of them") {
        test("with no controller, the motors are driven at the failsafe throttle - and never at any other") {
            air := new radio_pair();
            time := new fake_clock();
            time.advance(1000);
            thrust := mock<motors>();
            computer := new flight_computer(new drone_devices(air.second, time, mock<distance_sensor>(), thrust, mock<battery>()));

            for(i : _int64 = 0; i < 20; i++) {
                computer.step();
                time.advance(10);
            }

            verify { thrust.drive(FAILSAFE_THROTTLE, any_number(), any_number(), any_number()); }.at_least(1);
            verify_nothing_else(thrust);            // every single command was the failsafe one
        };

        test("the height sensor and the battery are read, and what they say is what telemetry carries") {
            air := new radio_pair();
            time := new fake_clock();
            time.advance(1000);
            ground := mock<distance_sensor>();
            power := mock<battery>();
            given { ground.read_cm(); }.returns(120);
            given { power.level(); }.returns(2);
            computer := new flight_computer(new drone_devices(air.second, time, ground, mock<motors>(), power));
            controller := new radio_link(air.first, time);

            controller.connect();
            for(i : _int64 = 0; i < 70; i++) {
                controller.step();
                computer.step();
                time.advance(10);
            }

            verify { ground.read_cm(); }.at_least(1);
            verify { power.level(); }.at_least(1);

            reading : message? = null;
            for(;;) {
                arrived := controller.next();
                if(arrived == null) { break; }
                if(arrived!!.type == message_types.TELEMETRY) { reading = arrived; }
            }
            expect_not_null(reading);
            read := telemetry.from_message(reading!!);
            expect_not_null(read);
            expect(read!!.altitude_cm).should_be(120);
            expect(read!!.battery).should_be(2);
        };

        test("devices that say nothing at all do not stop the drone: every reading is 0") {
            air := new radio_pair();
            time := new fake_clock();
            time.advance(1000);
            computer := new flight_computer(new drone_devices(air.second, time, mock<distance_sensor>(), mock<motors>(), mock<battery>()));

            for(i : _int64 = 0; i < 50; i++) {
                computer.step();
                time.advance(10);
            }

            expect_true(computer.state.failsafe);
        };
    };
}

def main(args: string[]) : int {
    test_failsafe_before_contact();
    test_mode_and_sticks();
    test_telemetry();
    test_altimeter();
    test_losing_the_controller();
    test_shutting_down();
    test_jam_and_unknown();
    test_what_the_drone_asks_of_its_devices();
    finish_tests();
    return 0;
}
