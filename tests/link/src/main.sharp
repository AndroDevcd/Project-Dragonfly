mod main;

import ( std, std.testing, link, link.hardware, link.protocol, link.messages );

/**
 * THE LINK, TESTED ON A PC
 *
 * Two links talk over two fake radios joined in memory, with a clock the test
 * moves itself. No hardware, no threads, no waiting: every test says exactly
 * which frames are lost and what has to happen then.
 *
 *      sharpc -P tests/link        then        sharp tests/link/build/outputs/link_tests
 */

/** two links that hear each other, and the clock they share */
class bench {
    air := new radio_pair();
    time := new fake_clock();
    a : radio_link;                 // "the controller"
    b : radio_link;                 // "the drone"

    bench() {
        time.advance(1000);         // not 0: so "a while ago" can be told from "never"
        a = new radio_link(air.first, time);
        b = new radio_link(air.second, time);
    }

    /** both sides do their work `rounds` times, `ms` apart */
    def run(rounds: _int64, ms: _int64) {
        for(i : _int64 = 0; i < rounds; i++) {
            a.step();
            b.step();
            time.advance(ms);
        }
    }

    def connect() {
        a.connect();
        run(10, 5);
    }
}

/** `count` bytes that are easy to check: byte i is i mod 251 */
def pattern(count: _int64) : _uint8[] {
    bytes := new _uint8[count];
    for(i : _int64 = 0; i < count; i++) { bytes[i] = i % 251; }
    return bytes;
}

def same_bytes(left: _uint8[], right: _uint8[]) : _int64 {
    if(sizeof(left) != sizeof(right)) { return false; }
    for(i : _int64 = 0; i < sizeof(left); i++) {
        if(left[i] != right[i]) { return false; }
    }
    return true;
}

def test_bytes() {
    tests("bytes: numbers and text in, the same out") {
        w := new byte_writer();
        w.u8(200).u16(65000).u32(4000000000).i64(0 - 5).text("dragonfly").text("");
        r := new byte_reader(w.bytes());
        test("u8") { expect(r.u8()).should_be(200); };
        test("u16") { expect(r.u16()).should_be(65000); };
        test("u32") { expect(r.u32()).should_be(4000000000); };
        test("i64") { expect(r.i64()).should_be(0 - 5); };
        test("text") { expect(r.text()).should_be("dragonfly"); };
        test("empty text") { expect(r.text()).should_be(""); };
        test("everything asked for was there") { expect_true(r.ok()); };
        r.u8();
        test("reading past the end is noticed, not thrown") { expect_true(!r.ok()); };
    };
}

def test_frames() {
    tests("frames: 32 bytes and back") {
        f := new frame();
        f.type = 17;
        f.flags = FLAG_RELIABLE | FLAG_LAST;
        f.number = 40000;
        f.piece = 513;
        f.payload = pattern(25);
        bytes := f.encode();
        test("a frame is the radio's frame size") { expect(sizeof(bytes)).should_be(FRAME_SIZE); };
        back := frame.decode(bytes);
        test("it decodes") { expect_true(back != null); };
        if(back != null) {
            test("type") { expect(back!!.type).should_be(17); };
            test("number") { expect(back!!.number).should_be(40000); };
            test("piece") { expect(back!!.piece).should_be(513); };
            test("reliable and last") { expect_true(back!!.is_reliable() && back!!.is_last() && !back!!.is_ack()); };
            test("payload") { expect_true(same_bytes(back!!.payload, pattern(25))); };
        }
        bad := new _uint8[32];
        bad[6] = 30;                                    // says 30 bytes of payload: more than a frame holds
        test("a frame with an impossible length is refused") { expect_true(frame.decode(bad) == null); };
        test("too few bytes are refused") { expect_true(frame.decode(new _uint8[3]) == null); };
    };
}

def test_connect() {
    tests("connecting") {
        t := new bench();
        test("both start disconnected") { expect(t.a.state() + t.b.state()).should_be(0); };
        changes : _int64 = 0;
        t.b.on_state_changed = { state: _int64 -> changes++; };
        t.connect();
        test("the caller is connected") { expect_true(t.a.is_connected()); };
        test("the called side is connected") { expect_true(t.b.is_connected()); };
        test("the called side was told once") { expect(changes).should_be(1); };
        test("the hello is not handed to the program") { expect_true(t.b.next() == null); };
    };
}

def test_small_message() {
    tests("a small reliable message") {
        t := new bench();
        t.connect();
        id := t.a.send(new set_mode(MODE_SPORT).to_message());
        test("not delivered before anything ran") { expect_true(!t.a.is_delivered(id)); };
        t.run(4, 5);
        test("delivered") { expect_true(t.a.is_delivered(id)); };
        got := t.b.next();
        test("it arrived") { expect_true(got != null); };
        if(got != null) {
            mode := set_mode.from_message(got!!);
            test("it is a set_mode") { expect_true(mode != null); };
            if(mode != null) { test("the mode") { expect(mode!!.mode).should_be(MODE_SPORT); }; }
        }
        test("it arrived once") { expect_true(t.b.next() == null); };
    };
}

def test_long_message() {
    tests("a long message: chained frames") {
        t := new bench();
        t.connect();
        sent := pattern(5000);
        before : _int64 = t.a.frames_sent;
        id := t.a.send(new message(message_types.NOTICE, sent));
        t.run(260, 1);
        test("delivered") { expect_true(t.a.is_delivered(id)); };
        got := t.b.next();
        test("it arrived") { expect_true(got != null); };
        if(got != null) {
            test("every byte") { expect(sizeof(got!!.body)).should_be(5000); };
            test("in the right order") { expect_true(same_bytes(got!!.body, sent)); };
        }
        test("5,000 bytes are 200 frames of 25") { expect(t.a.frames_sent - before).should_be(200); };

        // text through the typed message, longer than one frame
        words := "";
        for(i : _int64 = 0; i < 40; i++) { words = words + "line " + i + " of the flight log; "; }
        t.b.send(new notice(NOTICE_WARNING, words).to_message());
        t.run(120, 1);
        back := t.a.next();
        test("a long notice arrived") { expect_true(back != null); };
        if(back != null) {
            read := notice.from_message(back!!);
            test("it is a notice") { expect_true(read != null); };
            if(read != null) {
                test("its level") { expect(read!!.level).should_be(NOTICE_WARNING); };
                test("its text") { expect(read!!.text).should_be(words); };
            }
        }

        // a message with no bytes at all still travels
        t.a.send(new message(message_types.SET_MODE));
        t.run(4, 5);
        empty := t.b.next();
        test("a message without bytes arrives") { expect_true(empty != null && sizeof(empty!!.body) == 0); };
    };
}

def test_lost_frames() {
    tests("lost frames are sent again") {
        t := new bench();
        t.connect();
        t.air.first.lose_every(3);              // every third frame the sender transmits disappears
        sent := pattern(1000);
        id := t.a.send(new message(message_types.NOTICE, sent));
        t.run(400, 10);
        test("delivered all the same") { expect_true(t.a.is_delivered(id)); };
        test("some pieces had to be sent again") { expect_true(t.a.resends > 0); };
        got := t.b.next();
        test("whole and in order") { expect_true(got != null && same_bytes(got!!.body, sent)); };
        test("delivered once") { expect_true(t.b.next() == null); };
    };
}

def test_lost_acknowledgements() {
    tests("a lost acknowledgement does not deliver a message twice") {
        t := new bench();
        t.connect();
        t.air.second.lose_every(2);             // half of what the RECEIVER says back is lost
        first := t.a.send(new set_mode(MODE_SPORT).to_message());
        second := t.a.send(new set_mode(MODE_NORMAL).to_message());
        t.run(200, 10);
        test("both delivered") { expect_true(t.a.is_delivered(first) && t.a.is_delivered(second)); };
        one := t.b.next();
        two := t.b.next();
        test("two messages arrived") { expect_true(one != null && two != null); };
        if(one != null && two != null) {
            test("the first one first") { expect(set_mode.from_message(one!!)!!.mode).should_be(MODE_SPORT); };
            test("then the second") { expect(set_mode.from_message(two!!)!!.mode).should_be(MODE_NORMAL); };
        }
        test("and no third") { expect_true(t.b.next() == null); };
    };
}

def test_giving_up() {
    tests("a message that cannot get through fails, and the next one goes on") {
        t := new bench();
        t.connect();
        t.air.first.set_blocked(true);
        id := t.a.send(new set_mode(MODE_SPORT).to_message());
        t.run(60, 10);
        test("it failed") { expect_true(t.a.has_failed(id)); };
        test("it is not reported as delivered") { expect_true(!t.a.is_delivered(id)); };
        test("nothing is left waiting") { expect_true(t.a.pending() <= 1); };          // (at most the hello of a new connection attempt)

        t.air.first.set_blocked(false);
        again := t.a.send(new set_mode(MODE_NORMAL).to_message());
        t.run(60, 10);
        test("the next message is delivered") { expect_true(t.a.is_delivered(again)); };
    };
}

def test_telemetry() {
    tests("telemetry: sent once; a broken one is thrown away") {
        t := new bench();
        t.connect();
        t.b.publish(new telemetry(1234, 250, 3, MODE_NORMAL).to_message());
        t.run(2, 5);
        got := t.a.next();
        test("it arrived") { expect_true(got != null); };
        if(got != null) {
            read := telemetry.from_message(got!!);
            test("it is telemetry") { expect_true(read != null); };
            if(read != null) {
                test("altitude") { expect(read!!.altitude_cm).should_be(1234); };
                test("speed") { expect(read!!.speed_cm_s).should_be(250); };
                test("battery") { expect(read!!.battery).should_be(3); };
            }
        }

        // a three-frame message that loses its middle frame never arrives ...
        t.air.second.lose_next(0);
        before : _int64 = t.b.frames_sent;
        t.air.second.lose_every(0);
        long := new message(message_types.TELEMETRY, pattern(60));
        t.air.second.lose_next(0);
        t.b.publish(long);
        // lose exactly the second frame of the three: let one out, then lose one
        t.air.second.lose_next(0);
        t.b.step();                                     // (all three go out in this step; see below)
        t.a.step();
        whole := t.a.next();
        test("an unbroken three-frame telemetry arrives") { expect_true(whole != null && sizeof(whole!!.body) == 60); };
        test("it was three frames") { expect(t.b.frames_sent - before).should_be(3); };

        t.air.second.lose_every(2);                     // now every second frame is lost
        t.b.publish(long);
        t.b.step();
        t.a.step();
        test("one with a frame missing is thrown away") { expect_true(t.a.next() == null); };
        test("it was not sent again") { expect(t.b.resends).should_be(0); };

        // ... and the one after it is fine
        t.air.second.lose_every(0);
        t.b.publish(new telemetry(1, 2, 4, MODE_SPORT).to_message());
        t.b.step();
        t.a.step();
        after := t.a.next();
        test("the next reading arrives") { expect_true(after != null && telemetry.from_message(after!!) != null); };
    };
}

def test_losing_the_connection() {
    tests("silence: lost, and found again") {
        t := new bench();
        t.connect();
        seen := new number_list();
        t.a.on_state_changed = { state: _int64 -> seen.add(state); };

        // while both run, heartbeats keep the connection up through a long quiet time
        t.run(400, 10);                                 // 4 seconds with nothing to say
        test("still connected after 4 quiet seconds") { expect_true(t.a.is_connected() && t.b.is_connected()); };
        test("no change was reported") { expect(seen.size()).should_be(0); };

        // the drone flies out of range
        t.air.first.set_blocked(true);
        t.air.second.set_blocked(true);
        t.run(200, 10);                                 // 2 seconds of real silence
        test("the controller says lost") { expect(t.a.state()).should_be(LINK_LOST); };
        test("the drone says lost") { expect(t.b.state()).should_be(LINK_LOST); };

        // back in range
        t.air.first.set_blocked(false);
        t.air.second.set_blocked(false);
        t.run(100, 10);
        test("connected again") { expect_true(t.a.is_connected() && t.b.is_connected()); };
        test("lost and connected were reported, in that order") { expect_true(seen.size() == 2 && seen.at(0) == LINK_LOST && seen.at(1) == LINK_CONNECTED); };

        // and a message goes through as before
        id := t.a.send(new jam(77).to_message());
        t.run(10, 5);
        test("a message after reconnecting is delivered") { expect_true(t.a.is_delivered(id)); };
        got := t.b.next();
        test("and is the jam that was sent") { expect_true(got != null && jam.from_message(got!!) != null && jam.from_message(got!!)!!.channel == 77); };
    };
}

def test_typed_messages() {
    tests("the messages: each one, in and out") {
        s := steer.from_message(new steer(0 - 1000, 1000, 250, 0 - 3).to_message());
        test("steer") { expect_true(s != null && s!!.throttle == 0 - 1000 && s!!.yaw == 1000 && s!!.pitch == 250 && s!!.roll == 0 - 3); };
        limited := new steer(5000, 0 - 5000, 0, 0);
        test("steer keeps its values within -1000 .. 1000") { expect_true(limited.throttle == 1000 && limited.yaw == 0 - 1000); };
        test("a message of another kind is not a steer") { expect_true(steer.from_message(new set_mode(1).to_message()) == null); };
        test("a steer cut short is refused") { expect_true(steer.from_message(new message(message_types.STEER, new _uint8[3])) == null); };
        test("a kind has a name") { expect(message_types.name_of(message_types.TELEMETRY)).should_be("telemetry"); };
    };
}

/** commands typed at the console: put together from keys that arrive a few at a time */
def test_console_commands() {
    tests("console commands") {
        keys := new fake_keys();
        time := new fake_clock();
        commands := new command_line(keys, time);

        test("nothing typed: no command") { expect_true(commands.next() == null); };

        // a command arrives in pieces, over several looks at the keyboard
        keys.type("q");
        time.advance(60);
        test("a letter without Enter is not a command yet") { expect_true(commands.next() == null); };
        keys.type("\n");
        time.advance(60);
        typed := commands.next();
        test("Enter finishes it") { expect_true(typed != null); };
        if(typed != null) {
            test("the command") { expect(typed!!).should_be("q"); };
            test("q is the command to stop") { expect_true(is_quit_command(typed!!)); };
        }

        // the keyboard is looked at only every 50 ms
        keys.type("quit\n");
        time.advance(10);
        test("not looked at again so soon") { expect_true(commands.next() == null); };
        time.advance(50);
        typed = commands.next();
        test("looked at once the time has passed") { expect_true(typed != null); };
        if(typed != null) { test("the command") { expect(typed!!).should_be("quit"); }; }

        // spaces around it, capital letters, backspace, Windows' Enter
        keys.type("  STOx");
        keys.press(127);
        keys.type("P \r");
        time.advance(60);
        typed = commands.next();
        test("a command with a correction") { expect_true(typed != null); };
        if(typed != null) {
            test("trimmed, small letters, the x taken back") { expect(typed!!).should_be("stop"); };
            test("stop is a command to stop too") { expect_true(is_quit_command(typed!!)); };
        }

        // empty lines are not commands; two commands typed at once come one at a time
        keys.type("\n   \nfoo\nq\n");
        time.advance(60);
        typed = commands.next();
        test("the empty lines are passed over") { expect_true(typed != null); };
        if(typed != null) {
            test("the first command") { expect(typed!!).should_be("foo"); };
            test("foo is not a command to stop") { expect_true(!is_quit_command(typed!!)); };
        }
        time.advance(60);
        typed = commands.next();
        test("the second command is still there") { expect_true(typed != null); };
        if(typed != null) { test("the second command") { expect(typed!!).should_be("q"); }; }
        time.advance(60);
        test("and then nothing") { expect_true(commands.next() == null); };
    };
}

/** radios on different channels do not hear each other; the scanner finds the busy ones */
def test_channels() {
    tests("channels and the scanner") {
        t := new bench();
        t.a.connect();
        t.run(10, 5);
        test("connected on the home channel") { expect_true(t.a.is_connected() && t.b.is_connected()); };

        t.air.first.set_channel(40);
        t.run(400, 5);                          // two seconds
        test("on different channels the two lose each other") { expect_true(!t.a.is_connected()); };
        t.air.second.set_channel(40);
        t.run(20, 5);
        test("on the same one again, they find each other") { expect_true(t.a.is_connected() && t.b.is_connected()); };

        // the scanner
        radio := new fake_radio();
        radio.make_busy(37);
        scan := new channel_scanner(radio);
        test("nothing heard before it looked") { expect(scan.level(37)).should_be(0); };
        for(i : _int64 = 0; i < 21 * 10; i++) { scan.step(); }  // 21 steps a sweep, 10 sweeps
        test("sweeps counted") { expect(scan.sweeps).should_be(10); };
        test("the busy channel is high") { expect_true(scan.level(37) > 600); };
        test("a quiet one is nothing") { expect(scan.level(100)).should_be(0); };
        test("the busiest") { expect(scan.busiest()).should_be(37); };
        test("the quietest: the highest of the quiet ones") { expect(scan.quietest()).should_be(125); };

        radio.make_busy(120);
        radio.make_busy(123);
        radio.make_busy(125);
        for(i : _int64 = 0; i < 21 * 10; i++) { scan.step(); }
        best : _int64 = scan.quietest();
        test("the quietest keeps away from busy neighbours") { expect_true(best < 118 && best != 37 && (best < 35 || best > 39)); };

        radio.make_quiet(37);
        for(i : _int64 = 0; i < 21 * 30; i++) { scan.step(); }
        test("a channel that went quiet drops again") { expect_true(scan.level(37) < 50); };
        test("the radio is back on its own channel") { expect(radio.current_channel()).should_be(RADIO_CHANNEL); };
    };
}

/** the way home: a side that hears nothing on another channel goes back to the home channel */
def test_going_home() {
    tests("going home after silence") {
        t := new bench();
        keeper_a := new channel_keeper(t.air.first, t.a, t.time);
        keeper_b := new channel_keeper(t.air.second, t.b, t.time);
        t.a.connect();
        t.run(10, 5);
        test("connected") { expect_true(t.a.is_connected()); };

        keeper_a.move_to(70);
        keeper_b.move_to(70);
        for(i : _int64 = 0; i < 200; i++) {
            t.run(1, 5);
            keeper_a.step();
            keeper_b.step();
        }
        test("both moved: still connected on 70") { expect_true(t.a.is_connected() && keeper_a.current() == 70); };
        test("nobody went home") { expect(keeper_a.went_home + keeper_b.went_home).should_be(0); };

        // only one side moves (the other never heard of it)
        keeper_a.move_to(90);
        for(i : _int64 = 0; i < 300; i++) {     // 1.5 seconds
            t.run(1, 5);
            keeper_a.step();
            keeper_b.step();
        }
        test("apart: not yet home after 1.5 s") { expect_true(keeper_a.current() == 90); };
        for(i : _int64 = 0; i < 700; i++) {     // 3.5 seconds more
            t.run(1, 5);
            keeper_a.step();
            keeper_b.step();
        }
        test("the lost side went home") { expect(keeper_a.current()).should_be(RADIO_CHANNEL); };
        test("so did the other") { expect(keeper_b.current()).should_be(RADIO_CHANNEL); };
        test("and they found each other there") { expect_true(t.a.is_connected() && t.b.is_connected()); };
    };
}

def main(args: string[]) : int {
    test_channels();
    test_going_home();
    test_console_commands();
    test_bytes();
    test_frames();
    test_connect();
    test_small_message();
    test_long_message();
    test_lost_frames();
    test_lost_acknowledgements();
    test_giving_up();
    test_telemetry();
    test_losing_the_connection();
    test_typed_messages();
    finish_tests();
    return 0;
}
