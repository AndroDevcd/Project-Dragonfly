mod controller.screens;

import ( std, ui, controller, controller.hardware, link, link.hardware );

/**
 * THE CHANNELS: how busy the whole 2.4 GHz band is, one bar a channel
 *
 *      12:30                          [mode] [signal] [battery]
 *      ------------------------------------------------------
 *            |          ||
 *        ||  |||       ||||    |                          |
 *      ________________________________________________________
 *      |  '     |  '     |  '   |        |            ^     |
 *      0       25       50     75      100              125
 *      on121 best98 busy37
 *
 * 126 channels, 126 columns of the 128 the screen has: channel 0 on the left,
 * 125 on the right. A bar's height is how often something strong was heard
 * there lately (link/scanner.sharp). Under the line:
 *
 *      |   a channel with its number under it: 0, 25, 50, 75, 100, 125
 *      '   Wi-Fi's channels 1, 6 and 11 (where a router usually is)
 *      ^   the channel Dragonfly is on (the tallest mark)
 *
 * The buttons:
 *
 *      both together       move to the quietest channel (the drone is told first)
 *      either one          back to the settings
 *
 * The scanner runs only while this screen is open: listening on other channels
 * takes the radio's time, and the link loses a few more frames meanwhile.
 */
const GRAPH_HEIGHT : _int64 = 20;               // the bars
const SCALE_HEIGHT : _int64 = 4;                // the line under them and the marks below it
const GRAPH_LEFT : _int64 = 1;                  // where channel 0's column is on the screen

// the three things the bottom row can do
const ACTION_MOVE : _int64 = 0;                 // move both sides to the quietest channel
const ACTION_JAM : _int64 = 1;                  // jam (the channel and time are settings)
const ACTION_BACK : _int64 = 2;                 // back to the settings
const ACTION_COUNT : _int64 = 3;

class channels_screen base screen {
    private app : controller_app;
    private action : _int64 = ACTION_MOVE;       // which of the three is marked

    channels_screen(app: controller_app) {
        self->app = app;
    }

    override def on_enter() {
        app.start_scan();
    }

    override def on_button(button: _int64) {
        if(button == BUTTON_UP) {
            action = (action + ACTION_COUNT - 1) % ACTION_COUNT;
            return;
        }
        if(button == BUTTON_DOWN) {
            action = (action + 1) % ACTION_COUNT;
            return;
        }
        if(button != BUTTON_SELECT) { return; }

        if(action == ACTION_MOVE) {
            if(app.scanner != null) { app.change_channel(app.scanner!!.quietest()); }
        } else if(action == ACTION_JAM) {
            if(app.start_jam()) { app.screens.open(new jam_screen(app)); }
        } else {
            app.stop_scan();
            app.screens.back();
        }
    }

    override def body() : view {
        bar := status_bar(app.state);
        root := relative().add(bar.at_top());
        if(app.scanner == null) {
            root.add(text("no scanner on this radio").center());
            return root;
        }
        scan : channel_scanner = app.scanner!!;

        graph := picture(spectrum(scan, app.channel()));
        root.add(graph.below(bar).at_left().margin_left(GRAPH_LEFT).margin_top(1));

        // the axis is the Wi-Fi channels (1 .. 14), not the nRF24's 0 .. 125. Only a few are
        // numbered - the ticks under the graph mark every one, so the numbers between are plain.
        labels := new _int64[4];
        labels[0] = 1;
        labels[1] = 6;
        labels[2] = 11;
        labels[3] = 14;
        for(i : _int64 = 0; i < 4; i++) {
            number : string = "" + labels[i];
            wide : _int64 = sizeof(number.data) * GLYPH_WIDTH;
            x : _int64 = GRAPH_LEFT + wifi_centre(labels[i]) - wide / 2;
            if(x < 0) { x = 0; }
            if(x + wide > DISPLAY_WIDTH) { x = DISPLAY_WIDTH - wide; }
            root.add(text(number).below(graph).at_left().margin_left(x));
        }

        // a short word about what the radio is doing (a move, a jam, or the scan's findings)
        words : string = "scanning";
        if(app.is_jamming()) {
            words = "jamming " + app.jam_channel();
        } else if(app.channel_is_pending()) {
            words = "moving to " + app.channel_wanted;
        } else if(sizeof(app.state.notice_text.data) > 0) {
            words = app.state.notice_text;
        } else if(scan.sweeps > 0) {
            words = "on" + app.channel() + " best" + scan.quietest() + " busy" + scan.busiest();
        }
        info := text(words);
        root.add(info.below(graph).at_left().margin_left(1).margin_top(8));

        // the action row: the marked one in [brackets]
        move_word : string = "Move";
        jam_word : string = "Jam";
        back_word : string = "Back";
        if(action == ACTION_MOVE) { move_word = "[Move]"; }
        else if(action == ACTION_JAM) { jam_word = "[Jam]"; }
        else { back_word = "[Back]"; }
        root.add(text(move_word + " " + jam_word + " " + back_word).below(info).at_left().margin_left(1));
        return root;
    }
}

/** the picture of the band: a bar for each channel, the scale and its marks under them */
def spectrum(scan: channel_scanner, on_channel: _int64) : image {
    width : _int64 = CHANNEL_COUNT;
    height : _int64 = GRAPH_HEIGHT + SCALE_HEIGHT;
    pixels := new _uint8[width * height];

    for(c : _int64 = 0; c < width; c++) {
        // the bar: from the bottom of the graph up; anything heard at all is at least one pixel
        tall : _int64 = (scan.level(c) * GRAPH_HEIGHT) / LEVEL_MAX;
        if(tall == 0 && scan.level(c) > 0) { tall = 1; }
        for(row : _int64 = GRAPH_HEIGHT - tall; row < GRAPH_HEIGHT; row++) {
            pixels[row * width + c] = PIXEL_ON;
        }
        // the line under the bars
        pixels[GRAPH_HEIGHT * width + c] = PIXEL_ON;
    }

    // a tick under the line at every Wi-Fi channel centre (1 .. 14), two pixels deep
    for(n : _int64 = 1; n <= 14; n++) {
        centre : _int64 = wifi_centre(n);
        pixels[(GRAPH_HEIGHT + 1) * width + centre] = PIXEL_ON;
        pixels[(GRAPH_HEIGHT + 2) * width + centre] = PIXEL_ON;
    }
    // the channel the radio is on: a mark all the way down, so it stands out from the Wi-Fi ticks
    if(on_channel >= 0 && on_channel < width) {
        for(row : _int64 = GRAPH_HEIGHT + 1; row < height; row++) {
            pixels[row * width + on_channel] = PIXEL_ON;
        }
    }
    return new image("spectrum", width, height, pixels);
}

/** the nRF24 channel at the centre of a Wi-Fi channel (1 .. 14): Wi-Fi 1 = 2412 MHz = channel 12,
    then every 5 channels; 14 sits apart at 84 (2484 MHz) */
def wifi_centre(n: _int64) : _int64 {
    if(n >= 14) { return 84; }
    return 7 + 5 * n;
}
