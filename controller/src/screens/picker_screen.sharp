mod controller.screens;

import ( std, ui, controller, link.protocol );

/**
 * A REUSABLE "PICK ONE VALUE" SCREEN
 *
 *      12:30                       [mode] [signal] [battery]
 *      ------------------------------------------------------
 *                     Jam ch
 *
 *                       50
 *
 *                 hold to go faster
 *
 * Any setting with more than a couple of values uses this instead of being
 * cycled one press at a time on the settings list. A setting describes itself
 * through `value_setting` (its title, its allowed values, how a value reads,
 * and how to save it), so one screen serves them all.
 *
 *      up / down       the next / previous value
 *      hold up or down the presses repeat, and SPEED UP the longer you hold
 *                      (1 at a time, then 3, then 10)
 *      both together   asks to save: [Save] or Cancel, both together to choose
 *
 * Nothing is saved until Save is chosen, so leaving by Cancel changes nothing.
 */
const PICK_FAST_WINDOW_MS : _int64 = 400;       // two presses closer than this count as "still holding"

class picker_screen base screen {
    private app : controller_app;
    private setting : value_setting;
    private values : number_list;
    private index : _int64 = 0;

    private confirming : _int64 = false;         // choosing Save / Cancel
    private will_save : _int64 = true;

    // for speeding up while held
    private last_dir : _int64 = 0;
    private last_move_at : _int64 = 0;
    private run : _int64 = 0;                     // presses in a row the same way

    picker_screen(app: controller_app, setting: value_setting) {
        self->app = app;
        self->setting = setting;
        values = setting.values();
        index = index_of(setting.current());
    }

    private def index_of(value: _int64) : _int64 {
        for(i : _int64 = 0; i < values.size(); i++) {
            if(values.at(i) == value) { return i; }
        }
        return 0;
    }

    override def on_enter() { }

    override def on_button(button: _int64) {
        if(confirming) {
            if(button == BUTTON_UP || button == BUTTON_DOWN) { will_save = !will_save; return; }
            if(button != BUTTON_SELECT) { return; }
            if(will_save) { setting.apply(values.at(index)); }
            app.screens.back();
            return;
        }
        if(button == BUTTON_UP) { move(0 - 1); return; }
        if(button == BUTTON_DOWN) { move(1); return; }
        // BUTTON_HOLD is not needed here: the held button's repeats already speed up (move)
        if(button == BUTTON_SELECT) {
            confirming = true;
            will_save = true;
        }
    }

    /** move `dir` (-1 up, +1 down), by more each time the same way is pressed quickly in a row */
    private def move(dir: _int64) {
        now : _int64 = app.now_ms();
        if(dir == last_dir && now - last_move_at < PICK_FAST_WINDOW_MS) { run++; }
        else { run = 0; }
        last_dir = dir;
        last_move_at = now;

        step : _int64 = 1;
        if(run >= 6) { step = 10; }
        else if(run >= 3) { step = 3; }

        count : _int64 = values.size();
        index = (((index + dir * step) % count) + count) % count;      // wraps round the ends
    }

    override def body() : view {
        bar := status_bar(app.state);
        root := relative().add(bar.at_top());
        root.add(text(setting.title()).below(bar).center_across().margin_top(3));

        value : _int64 = values.at(index);
        big := text(setting.label(value)).size(2);
        root.add(big.below(bar).center_across().margin_top(16));

        // a small note under the value, e.g. a channel's frequency ("2437 MHz  WiFi 6")
        note : string = setting.note(value);
        if(sizeof(note.data) > 0) {
            root.add(text(note).below(big).center_across().margin_top(3));
        }

        if(confirming) {
            save_word : string = "Save";
            cancel_word : string = "Cancel";
            if(will_save) { save_word = "[Save]"; } else { cancel_word = "[Cancel]"; }
            save_view := text(save_word);
            root.add(save_view.at_bottom().at_left().margin_left(14));
            root.add(text(cancel_word).right_of(save_view).align_top(save_view).margin_left(12));
        } else {
            root.add(text("hold to go faster").at_bottom().center_across());
        }
        return root;
    }
}

/**
 * WHAT A PICKER NEEDS FROM A SETTING. A small class per setting (below) joins the picker to
 * the `settings` it changes.
 */
interface value_setting {
    def title() : string;                       // a short name at the top
    def values() : number_list;                 // every value the pilot may pick, in order
    def current() : _int64;                     // the one chosen now
    def label(value: _int64) : string;          // how a value reads ("off", "20s", "50")
    def note(value: _int64) : string;           // a small line under it (a frequency), or "" for none
    def apply(value: _int64);                   // save it
}

/** a list of the whole numbers from `from` to `to`, `step` apart */
def value_range(from: _int64, to: _int64, step: _int64) : number_list {
    made := new number_list(1000);
    for(v : _int64 = from; v <= to; v = v + step) { made.add(v); }
    return made;
}

/** how long a jam lasts: off, 10 .. 60 seconds */
class jam_time_setting : value_setting {
    private chosen : settings;
    jam_time_setting(chosen: settings) { self->chosen = chosen; }
    override def title() : string { return "Jam time"; }
    override def values() : number_list { return value_range(0, 60, 10); }
    override def current() : _int64 { return chosen.jam_seconds; }
    override def label(value: _int64) : string {
        if(value <= 0) { return "off"; }
        return "" + value + "s";
    }
    override def note(value: _int64) : string { return ""; }
    override def apply(value: _int64) { chosen.set_jam_seconds(value); }
}

/** which channel the jammer disturbs: 0 .. 125 */
class jam_channel_setting : value_setting {
    private chosen : settings;
    jam_channel_setting(chosen: settings) { self->chosen = chosen; }
    override def title() : string { return "Jam channel"; }
    override def values() : number_list { return value_range(0, 125, 1); }
    override def current() : _int64 { return chosen.jam_channel; }
    override def label(value: _int64) : string { return "" + value; }

    // the nRF24 numbers 2.4 GHz in 1 MHz steps: channel N is 2400 + N MHz. Wi-Fi's channels are
    // 5 MHz apart on top of that - Wi-Fi 1 is 2412 MHz (channel 12), 6 is 2437 (37), 11 is 2462
    // (62) - so where a channel is a Wi-Fi centre its number is shown too.
    override def note(value: _int64) : string {
        here : string = "" + (2400 + value) + " MHz";
        if(value == 84) { return here + "  WiFi 14"; }
        if(value >= 12 && value <= 72 && ((value - 7) % 5) == 0) {
            n : _int64 = (value - 7) / 5;
            return here + "  WiFi " + n;
        }
        return here;
    }
    override def apply(value: _int64) { chosen.set_jam_channel(value); }
}

/** how strongly the radio transmits: 0 (least) .. 3 (most) */
class power_setting : value_setting {
    private chosen : settings;
    power_setting(chosen: settings) { self->chosen = chosen; }
    override def title() : string { return "Radio power"; }
    override def values() : number_list { return value_range(0, 3, 1); }
    override def current() : _int64 { return chosen.radio_power; }
    override def label(value: _int64) : string { return "" + value; }
    override def note(value: _int64) : string { return ""; }
    override def apply(value: _int64) { chosen.change_radio_power(value); }
}
