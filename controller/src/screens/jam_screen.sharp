mod controller.screens;

import ( std, ui, controller );

/**
 * THE JAM COUNTDOWN
 *
 *      12:30                       [mode] [signal] [battery]
 *      ------------------------------------------------------
 *                   jamming ch 50
 *
 *                       14
 *
 *                 press to cancel
 *
 * Choosing "Jam" on the channels screen brings the pilot here. The jam is
 * already running (controller_app.start_jam); this screen shows the seconds
 * left and lets the pilot stop it early - any button cancels. When the
 * countdown reaches zero the screen returns to the channels on its own.
 *
 * While the jam runs the controller does nothing but jam, read the buttons and
 * draw (controller_app.step), so the radio stays on the one channel. That is
 * also why this screen can show a live countdown: it is drawn every turn.
 */
class jam_screen base screen {
    private app : controller_app;

    jam_screen(app: controller_app) {
        self->app = app;
    }

    override def on_enter() { }

    // A running jam does not come back to the loop, so buttons are not read here - the jam itself
    // (in C++) watches the buttons and stops when one is pressed. Nothing to do here.
    override def on_button(button: _int64) { }

    override def body() : view {
        bar := status_bar(app.state);
        root := relative().add(bar.at_top());

        // the jam ended by itself: back to the channels (the same way the splash leaves)
        if(!app.is_jamming()) {
            app.screens.back();
            return root;
        }

        root.add(text("jamming ch " + app.jam_channel()).below(bar).center_across().margin_top(4));
        root.add(text("" + app.jam_low() + " - " + app.jam_high()).size(2).below(bar).center_across().margin_top(16));
        root.add(text("for " + app.jam_length() + "s").below(bar).center_across().margin_top(36));
        root.add(text("press a button to stop").at_bottom().center_across());
        return root;
    }
}
