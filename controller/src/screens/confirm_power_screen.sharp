mod controller.screens;

import ( std, ui, controller );

/**
 * "ARE YOU SURE YOU WOULD LIKE TO POWER DOWN?" - yes or no
 *
 *      12:30                       [mode] [signal] [battery]
 *      ------------------------------------------------------
 *               Are you sure you would
 *                  like to power down?
 *
 *                   Yes         [No]
 *
 * It is pushed on top of the settings when the pilot chooses "Power off".
 *
 *      up / down       move between Yes and No
 *      both together   choose the one that is marked
 *
 * "No" is marked to begin with, so a stray double-press does not turn the
 * controller off. "No" goes back to the settings; "Yes" powers down
 * (controller/main - the program stops, the hardware is left tidy, and on the
 * Raspberry Pi the Pi itself is told to power off).
 */
class confirm_power_screen base screen {
    private app : controller_app;
    private say_yes : _int64 = false;           // which of the two is marked (false = No, the safe one)

    confirm_power_screen(app: controller_app) {
        self->app = app;
    }

    override def on_enter() { }

    override def on_button(button: _int64) {
        if(button == BUTTON_UP || button == BUTTON_DOWN) {
            say_yes = !say_yes;                 // only two choices: either arrow moves between them
            return;
        }
        if(button != BUTTON_SELECT) { return; }
        if(say_yes) { app.power_off(); }
        else { app.screens.back(); }
    }

    override def body() : view {
        bar := status_bar(app.state);

        line_one := text("Are you sure you would");
        line_two := text("like to power down?");

        // the two choices side by side: the marked one in [brackets], each its own word so a
        // test (and the eye) can pick it out
        yes_word : string = "Yes";
        no_word : string = "No";
        if(say_yes) { yes_word = "[Yes]"; } else { no_word = "[No]"; }
        yes_choice := text(yes_word);
        no_choice := text(no_word);

        return relative()
            .add(bar.at_top())
            .add(line_one.below(bar).center_across().margin_top(10))
            .add(line_two.below(line_one).center_across().margin_top(2))
            .add(yes_choice.below(line_two).at_left().margin_left(34).margin_top(10))
            .add(no_choice.right_of(yes_choice).align_top(yes_choice).margin_left(18));
    }
}
