mod controller.screens;

import ( std, ui, ui.icons, controller, controller.hardware, link.messages );

/**
 * THE STATUS BAR: the strip at the top of every screen but the splash
 *
 *      12:30                          [mode] [signal] [battery]
 *      ------------------------------------------------------
 *
 * It is a function, not a class: given the state, it returns the views. The
 * home and settings screens put it at their top -
 *
 *      bar := status_bar(app.state);
 *      return relative().add(bar.at_top()) ...
 *
 * and whatever the state says when the frame is drawn is what the bar shows.
 */
const STATUS_BAR_HEIGHT : _int64 = 12;

def battery_icon(bars: _int64) : image {
    if(bars <= 0) { return icon_battery_0; }
    if(bars == 1) { return icon_battery_1; }
    if(bars == 2) { return icon_battery_2; }
    if(bars == 3) { return icon_battery_3; }
    return icon_battery_4;
}

def signal_icon(bars: _int64) : image {
    if(bars <= 0) { return icon_signal_0; }
    if(bars == 1) { return icon_signal_1; }
    if(bars == 2) { return icon_signal_2; }
    if(bars == 3) { return icon_signal_3; }
    return icon_signal_4;
}

def mode_icon(mode: _int64) : image {
    if(mode == MODE_SPORT) { return icon_sport_mode; }
    return icon_normal_mode;
}

def status_bar(state: controller_state) : relative_view {
    time := text(state.clock_text);
    battery := picture(battery_icon(state.battery));
    signal := picture(signal_icon(state.signal));
    mode := picture(mode_icon(state.drone_mode));
    line := picture(icon_thin_line);

    bar := relative();
    bar.fill_width().height(STATUS_BAR_HEIGHT);
    bar.add(time.at_left().at_top())
       .add(battery.at_right().at_top())
       .add(signal.left_of(battery).align_top(battery).margin_right(3))
       .add(mode.left_of(signal).align_top(signal).margin_right(3))
       .add(line.at_bottom());
    // the battery and the mode are the DRONE's: nothing to show before it has said anything
    battery.show_if(state.has_telemetry);
    mode.show_if(state.has_telemetry);
    return bar;
}
