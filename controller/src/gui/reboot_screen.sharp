mod controller.gui;

import ( std.guikit.* );

/**
 * "REBOOT?" - Yes or No. Pushed on top of the settings when the pilot chooses
 * "Reboot". "No" is highlighted to begin with, so a stray press does not restart
 * the controller. "No" goes back; "Yes" reboots the Raspberry Pi - which brings
 * the controller software and the display back up together.
 */
class reboot_screen base nav_screen {
    reboot_screen(nav: navigator) {
        arm(nav);
        focus.value = 0;                                // start on "No", the safe one
    }

    override def build() : element {
        t := gui.current_theme();
        begin();
        no := item({ -> back(); });
        yes := item({ -> model.reboot(); });
        return column(modifier().fill().background(t.background).padding(8)) {
            top_strip("Reboot", model.clock.value);
            spacer();
            text("Reboot the controller?").size(15).bold();
            text("the software and display will restart").size(11).dim();
            row(modifier()) {
                choice("No", no);
                choice("Yes", yes);
            }.gap(14).align(ALIGN_CENTER).justify(ALIGN_CENTER);
            spacer();
        }.gap(10).align(ALIGN_CENTER);
    }

    private def choice(words: string, it: ring_item) : element {
        t := gui.current_theme();
        box := modifier().padding(22, 10).corner(10).click(it.click);
        ink := t.text;
        if(it.marked == 1) { box = box.background(t.primary); ink = t.on_primary; }
        else { box = box.background(t.surface_high); }
        return text(words, box).size(14).bold().color(ink);
    }
}
