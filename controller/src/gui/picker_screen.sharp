mod controller.gui;

import ( std, std.guikit.* );

/**
 * PICK ONE VALUE - radio power, jam time, jam channel, jam width. One screen
 * serves them all; the route's `kind` says which. Nothing is saved until Save,
 * so leaving by Back (or Cancel) changes nothing.
 *
 * Here the buttons do not move a highlight: UP and DOWN change the value, SELECT
 * saves, BACK cancels - so the on-screen -, +, Save and Cancel and the two
 * hardware buttons all drive the one picker.
 */
class picker_screen base nav_screen {
    private kind : _int64;
    private values : _int64[] = new _int64[1];
    private idx := state(0);

    picker_screen(nav: navigator, kind: _int64) {
        arm(nav);
        self->kind = kind;
        values = values_for(kind);
        idx.value = nearest(current_for(kind));
    }

    // ---- the buttons change the value instead of moving a highlight
    override def up() { set_index(idx.peek() + 1); }
    override def down() { set_index(idx.peek() - 1); }
    override def select() { apply_for(kind, values[idx.peek()]); nav!!.back(); }
    // back() stays the base's: cancel

    private def set_index(to: _int64) {
        if(to < 0) { to = 0; }
        if(to >= sizeof(values)) { to = sizeof(values) - 1; }
        idx.value = to;
    }

    override def build() : element {
        t := gui.current_theme();
        value : _int64 = values[idx.value];
        note : string = note_for(kind, value);
        return column(modifier().fill().background(t.background).padding(8)) {
            top_strip(title_for(kind), model.clock.value);
            spacer();
            text(label_for(kind, value)).size(44).bold().color(t.primary);
            if(sizeof(note.data) > 0) { text(note).size(12).dim(); }
            row(modifier()) {
                step_button("-", { -> down(); });
                step_button("+", { -> up(); });
            }.gap(14).align(ALIGN_CENTER).justify(ALIGN_CENTER);
            spacer();
            row(modifier()) {
                flat_button("Cancel", { -> back(); });
                filled_button("Save", { -> select(); });
            }.gap(14).align(ALIGN_CENTER).justify(ALIGN_CENTER);
        }.gap(8).align(ALIGN_CENTER);
    }

    private def step_button(words: string, action: ()()) : element {
        t := gui.current_theme();
        return text(words, modifier().size(44, 40).background(t.surface_high).corner(10).click(action))
            .size(22).bold().align(ALIGN_CENTER);
    }
    private def flat_button(words: string, action: ()()) : element {
        t := gui.current_theme();
        return text(words, modifier().padding(18, 9).background(t.surface_high).corner(10).click(action)).size(13).bold();
    }
    private def filled_button(words: string, action: ()()) : element {
        t := gui.current_theme();
        return text(words, modifier().padding(18, 9).background(t.primary).corner(10).click(action)).size(13).bold().color(t.on_primary);
    }

    // ================================================================ the four settings

    private def nearest(value: _int64) : _int64 {
        best : _int64 = 0;
        for(i : _int64 = 0; i < sizeof(values); i++) {
            if(values[i] == value) { return i; }
            if(values[i] <= value) { best = i; }
        }
        return best;
    }

    private def values_for(kind: _int64) : _int64[] {
        if(kind == PICK_POWER) { return range(0, 3, 1); }
        if(kind == PICK_JAM_TIME) { return range(0, 60, 10); }
        if(kind == PICK_JAM_CHANNEL) { return range(0, 125, 1); }
        made := new _int64[7];                           // PICK_JAM_WIDTH: a chosen few
        made[0] = 3; made[1] = 6; made[2] = 11; made[3] = 20; made[4] = 30; made[5] = 50; made[6] = 62;
        return made;
    }

    private def current_for(kind: _int64) : _int64 {
        if(kind == PICK_POWER) { return model.radio_power.value; }
        if(kind == PICK_JAM_TIME) { return model.jam_seconds.value; }
        if(kind == PICK_JAM_CHANNEL) { return model.jam_channel_set.value; }
        return model.jam_width.value;
    }

    private def apply_for(kind: _int64, value: _int64) {
        if(kind == PICK_POWER) { model.set_power(value); }
        else if(kind == PICK_JAM_TIME) { model.set_jam_seconds(value); }
        else if(kind == PICK_JAM_CHANNEL) { model.set_jam_channel(value); }
        else { model.set_jam_width(value); }
    }

    private def title_for(kind: _int64) : string {
        if(kind == PICK_POWER) { return "Radio power"; }
        if(kind == PICK_JAM_TIME) { return "Jam time"; }
        if(kind == PICK_JAM_CHANNEL) { return "Jam channel"; }
        return "Jam width";
    }

    private def label_for(kind: _int64, value: _int64) : string {
        if(kind == PICK_JAM_TIME) {
            if(value <= 0) { return "off"; }
            return "" + value + "s";
        }
        if(kind == PICK_JAM_WIDTH) { return "+/- " + value; }
        return "" + value;
    }

    private def note_for(kind: _int64, value: _int64) : string {
        if(kind == PICK_JAM_WIDTH) { return "" + (2 * value + 1) + " MHz wide"; }
        if(kind != PICK_JAM_CHANNEL) { return ""; }
        // the nRF24 numbers 2.4 GHz in 1 MHz steps: channel N is 2400 + N MHz; name the Wi-Fi
        // channel it sits on (Wi-Fi 1 is channel 12, then every 5; 14 sits apart at 84)
        here : string = "" + (2400 + value) + " MHz";
        n : _int64 = 1;
        centre : _int64 = 12;
        step : _int64 = 1;
        while(step <= 13 && centre <= value) {
            n = step;
            centre = centre + 5;
            step = step + 1;
        }
        if(value >= 84) { n = 14; }
        return here + "   WiFi " + n;
    }
}

/** the whole numbers from `from` to `to`, `step` apart */
def range(from: _int64, to: _int64, step: _int64) : _int64[] {
    count : _int64 = (to - from) / step + 1;
    made := new _int64[count];
    i : _int64 = 0;
    for(v : _int64 = from; v <= to; v = v + step) { made[i] = v; i++; }
    return made;
}
