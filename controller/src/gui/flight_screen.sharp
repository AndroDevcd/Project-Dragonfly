mod controller.gui;

import ( std.guikit.* );

/**
 * THE FLIGHT SCREEN: what the pilot looks at while flying (320 x 240, landscape).
 *
 *       = 09:41                                 |||| --V [batt]
 *      +------------------------------------+  +------------------+
 *      | SPEED              ALTITUDE        |  | THROTTLE     0 % |
 *      | 142 cm/s           1.83 m          |  | HEADING        0 |
 *      |                                    |  | DISTANCE     0 m |
 *      +------------------------------------+  +------------------+
 *      +----------------------------------------------------------+
 *      | [left stick]           MODE               [right stick]   |
 *      |  THR / YAW            NORMAL              PITCH / ROLL     |
 *      +----------------------------------------------------------+
 *      [ a notice, for a few seconds, over the bottom ]
 *
 * The sticks sit at the two bottom corners, where the real ones are. While
 * there is no link the readings make way for "Signal lost" instead of showing
 * numbers that are no longer true. The "=" at the top opens the settings. The
 * screen decides nothing: it reads the model and hands clicks to it.
 */
// the height of the readings (and of "Signal lost" in their place): the three
// reading rows on the right, so the speed card beside them is as tall as they are
const READINGS_HEIGHT : _int64 = 100;

class flight_screen base nav_screen {
    flight_screen(nav: navigator) {
        arm(nav);
    }

    override def build() : element {
        // the one thing the buttons do here: SELECT opens the settings (as the old home did)
        begin();
        open := item({ -> go(to_settings()); });
        // the notice floats over the bottom of the page, like a snackbar
        words : string = model.notice.value;
        return stack(modifier().fill()) {
            page(open);
            if(sizeof(words.data) > 0) {
                snackbar(words, { -> model.notice.value = ""; });
            }
        }.place(ALIGN_CENTER, ALIGN_END);
    }

    private def page(open: ring_item) : element {
        t := gui.current_theme();
        return column(modifier().fill().background(t.background).padding(8)) {
            status_bar(open);
            if(model.is_connected()) {
                readings();
            } else {
                no_link();
            }
            spacer();
            controls();
        }.gap(8);
    }

    /** the menu button and clock on the left; the signal, voltage and battery on the right */
    private def status_bar(open: ring_item) : element {
        t := gui.current_theme();
        menu_fill := (open.marked == 1) ? t.primary : t.surface_high;
        menu_ink := (open.marked == 1) ? t.on_primary : t.text_dim;
        return row(modifier().fill_width().padding(4, 0)) {
            text("MENU", modifier().padding(8, 3).corner(8).background(menu_fill).click(open.click))
                .size(10).bold().color(menu_ink);
            text(model.clock.value).size(14).bold();
            spacer();
            signal_bars(model.signal.value);
            text(model.volts_text() + "V").size(12).dim();
            battery_icon(model.battery_percent());
        }.gap(8).align(ALIGN_CENTER);
    }

    /** the speed and the altitude big on the left; the smaller readings listed on the right */
    private def readings() : element {
        t := gui.current_theme();
        return row(modifier().fill_width().height(READINGS_HEIGHT)) {
            row(card().grow(1.0).fill_height().padding(14, 12)) {
                column(modifier().grow(1.0)) {
                    caption("SPEED");
                    row(modifier()) {
                        text("" + model.speed.value).size(36).bold().color(t.primary);
                        text("cm/s").size(11).dim();
                    }.gap(4).align(ALIGN_END);
                }.gap(2);
                column(modifier()) {
                    caption("ALTITUDE");
                    row(modifier()) {
                        text(model.altitude_text()).size(24).bold();
                        text("m").size(11).dim();
                    }.gap(3).align(ALIGN_END);
                }.gap(2).align(ALIGN_END);
            }.align(ALIGN_CENTER);
            column(modifier().width(118)) {
                reading_row("THROTTLE", "" + model.throttle.value, "%");
                reading_row("HEADING", "" + model.heading.value, "");
                reading_row("DISTANCE", "" + model.distance.value, "m");
            }.gap(6);
        }.gap(8);
    }

    /** no link: say so, where the readings would be */
    private def no_link() : element {
        t := gui.current_theme();
        lost : _int64 = model.is_lost();
        words : string = lost ? "Signal lost" : "Searching";
        tint := lost ? t.danger : t.text_dim;
        return column(card().fill_width().height(READINGS_HEIGHT)) {
            text(words).size(20).bold().color(tint);
            text("bring the drone closer").size(11).dim();
        }.gap(4).align(ALIGN_CENTER).justify(ALIGN_CENTER);
    }

    /** the two sticks at the corners, and the mode chip between them */
    private def controls() : element {
        return row(card().fill_width().padding(10, 8)) {
            column(modifier()) {
                stick(model.left_x.value, model.left_y.value);
                caption("THR / YAW");
            }.gap(4).align(ALIGN_CENTER);
            spacer();
            column(modifier()) {
                caption("MODE");
                // the mode follows the physical sport switch; the chip just shows it (no toggle)
                mode_chip(model.flight_mode.value, { -> });
            }.gap(6).align(ALIGN_CENTER);
            spacer();
            column(modifier()) {
                stick(model.right_x.value, model.right_y.value);
                caption("PITCH / ROLL");
            }.gap(4).align(ALIGN_CENTER);
        }.align(ALIGN_CENTER);
    }
}
