mod controller.gui;

import ( std.guikit.*, link );

/**
 * THE CHANNELS: how busy the 2.4 GHz band is, a bar a channel, and what to do
 * about it - move to the quietest channel, jam a band, or go back.
 *
 * The scanner runs only while this screen is up (when_shown / when_gone): it
 * takes the radio's time, so the link loses a few frames meanwhile. The bars
 * are painted straight from the live scan on a canvas; the model bumps a tick a
 * few times a second so the picture keeps up without painting every frame.
 */
const SPECTRUM_HEIGHT : _int64 = 120;

// the three actions along the bottom
const CH_MOVE : _int64 = 0;
const CH_JAM : _int64 = 1;
const CH_BACK : _int64 = 2;

class channels_screen base nav_screen {
    channels_screen(nav: navigator) {
        arm(nav);
        when_shown({ -> model.start_scan(); });
        when_gone({ -> model.stop_scan(); });
    }

    override def build() : element {
        t := gui.current_theme();
        model.scan_tick.value;                          // repaint when the scan moves on
        begin();
        move := item({ -> model.change_channel(model.quietest()); });
        jam := item({ -> if(model.start_jam() == 1) { go(to_jam()); } });
        back := item({ -> back(); });
        return column(modifier().fill().background(t.background).padding(8)) {
            top_strip("Channels", model.clock.value);
            spectrum();
            info();
            actions(move, jam, back);
        }.gap(8);
    }

    /**
     * THE CHANNEL MAP, as a plain bar chart: one wide bar per WiFi channel (1 .. 14) along the X, an
     * approximate signal scale (dBm) up the Y, each bar as tall as how busy that band measured. The
     * bar for the channel the radio itself sits on is outlined; if the radio is off the WiFi band
     * (where it usually is) nothing is drawn for it - no stray marker line.
     *
     * The nRF24 senses energy, not WiFi packets, so it cannot name networks or read true dBm - each
     * bar is a WiFi channel's OCCUPANCY from the scan, and the dB scale is relative. nRF channel c is
     * (2400 + c) MHz; a WiFi channel is ~22 MHz wide (wifi_freq / band_occupancy below).
     */
    private def spectrum() : element {
        t := gui.current_theme();
        grid := t.border;
        ink := t.text_dim;
        strong := t.text;
        markc := t.primary;
        return canvas(card().fill_width().height(SPECTRUM_HEIGHT)) { p: painter, f: frame ->
            mL : decimal = 24.0;  mR : decimal = 6.0;  mT : decimal = 6.0;  mB : decimal = 14.0;
            px : decimal = mL;  py : decimal = mT;
            pw : decimal = f.width - mL - mR;
            ph : decimal = f.height - mT - mB;
            if(pw < 20.0 || ph < 20.0) { return; }

            small := gui.font(9.0);

            // horizontal dB gridlines and their labels (-40 .. -90); bar height uses the same scale,
            // so a bar top lines up with the dB readings (occ 0 -> -92 baseline, 1000 -> -30 top)
            gfade := p.fade(0.5);
            for(mag : _int64 = 40; mag <= 90; mag = mag + 10) {
                s : decimal = (92.0 - mag) / 62.0;
                yy : decimal = py + (1.0 - s) * ph;
                p.line(px, yy, px + pw, yy, 1.0, grid);
                lab : string = "-" + mag;
                p.text(lab, px - 3.0 - small.width_of(lab), yy - 5.0, small, ink);
            }
            p.unfade(gfade);

            got := model.controller().scanner;
            if(got == null) {
                msg : string = "scanning...";
                p.text(msg, px + pw / 2.0 - small.width_of(msg) / 2.0, py + ph / 2.0 - 4.0, small, ink);
                return;
            }
            scan := got!!;

            slot : decimal = pw / 14.0;          // one slot per WiFi channel
            gap : decimal = slot * 0.14;         // breathing room each side
            barw : decimal = slot - gap * 2.0;   // the bar itself, nice and wide
            rf : _int64 = 2400 + model.controller().channel();

            for(wc : _int64 = 1; wc <= 14; wc++) {
                occ : _int64 = band_occupancy(scan, wifi_freq(wc));
                frac : decimal = occ / 1000.0;
                if(frac > 1.0) { frac = 1.0; }
                bh : decimal = frac * ph;
                if(occ > 0 && bh < 2.0) { bh = 2.0; }
                bx : decimal = px + (wc - 1) * slot + gap;
                col := activity_color(occ);

                // a faint full-height track so empty channels still read as a slot
                trfade := p.fade(0.12);
                p.rect(bx, py, barw, ph, 4.0, grid);
                p.unfade(trfade);

                if(bh > 0.0) {
                    p.rect(bx, py + ph - bh, barw, bh, 4.0, col);
                }

                // channel number under the bar, 1 / 6 / 11 emphasised
                lab : string = "" + wc;
                emph : _int64 = (wc == 1 || wc == 6 || wc == 11) ? 1 : 0;
                was := p.fade(emph == 1 ? 1.0 : 0.6);
                p.text(lab, bx + barw / 2.0 - small.width_of(lab) / 2.0, py + ph + 3.0, small, emph == 1 ? strong : ink);
                p.unfade(was);

                // outline the bar the radio is sitting on (only when it falls in the WiFi band)
                if(rf >= wifi_freq(wc) - 2 && rf <= wifi_freq(wc) + 2) {
                    p.outline(bx - 1.0, py, barw + 2.0, ph, 4.0, 1.5, markc);
                }
            }
        }.still();
    }

    /** a word about what the radio is doing, or what the scan found */
    private def info() : element {
        words : string = scan_words();
        return text(words).size(11).dim();
    }

    private def scan_words() : string {
        if(model.channel_pending.value == 1) { return "moving to " + model.channel_wanted.value; }
        got := model.controller().scanner;
        if(got == null) { return "no scanner on this radio"; }
        scan := got!!;
        if(scan.sweeps > 0) { return "on " + model.channel.value + "   best " + scan.quietest() + "   busy " + scan.busiest(); }
        return "scanning";
    }

    private def actions(move: ring_item, jam: ring_item, back: ring_item) : element {
        return row(modifier().fill_width()) {
            action_chip("Move", move);
            action_chip("Jam", jam);
            action_chip("Back", back);
        }.gap(8).align(ALIGN_CENTER).justify(ALIGN_CENTER);
    }

    private def action_chip(words: string, it: ring_item) : element {
        t := gui.current_theme();
        box := modifier().padding(16, 8).corner(10).click(it.click);
        ink := t.text;
        if(it.marked == 1) { box = box.background(t.primary); ink = t.on_primary; }
        else { box = box.background(t.surface_high); }
        return text(words, box).size(12).bold().color(ink);
    }
}

/** the centre frequency (MHz) of 2.4 GHz WiFi channel 1 .. 14 */
def wifi_freq(channel: _int64) : _int64 {
    if(channel == 14) { return 2484; }
    return 2412 + (channel - 1) * 5;
}

/**
 * How busy the ~22 MHz band around `centre_freq` (MHz) measured: the strongest of the nRF24
 * channels that fall inside it (0 .. 1000). nRF channel c covers 2400 + c MHz.
 */
def band_occupancy(scan: channel_scanner, centre_freq: _int64) : _int64 {
    lo : _int64 = centre_freq - 11 - 2400;
    hi : _int64 = centre_freq + 11 - 2400;
    if(lo < 0) { lo = 0; }
    if(hi > 125) { hi = 125; }
    best : _int64 = 0;
    for(c : _int64 = lo; c <= hi; c++) {
        v : _int64 = scan.level(c);
        if(v > best) { best = v; }
    }
    return best;
}
