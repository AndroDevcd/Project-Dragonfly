mod ui;

import ( std, controller.hardware );

/**
 * THE UI TOOLKIT, PART 5: screens, and moving between them
 *
 * A SCREEN is three things:
 *
 *      body()          what is on it RIGHT NOW, described from the program's
 *                      state. It is asked for every frame, so a screen never
 *                      "updates" a view: when the altitude changes, the next
 *                      body() simply says the new number.
 *      on_button(b)    what a button does on this screen
 *      on_enter()      called when the screen becomes the one that is shown
 *
 * (Compose: a @Composable function. SwiftUI: `var body: some View`. Android:
 * what onCreateView + every setText you ever wrote amount to.)
 *
 * THE NAVIGATOR is the pile of screens: the one on top is shown.
 *
 *      nav.open(settings)      on top of the current one; back() returns here
 *      nav.replace(home)       instead of the current one (the splash does this)
 *      nav.back()              the top one goes away
 */
const BUTTON_NONE : _int64 = 0;
const BUTTON_UP : _int64 = 1;
const BUTTON_DOWN : _int64 = 2;
const BUTTON_SELECT : _int64 = 3;           // both buttons together

class screen {
    def body() : view;
    def on_button(button: _int64);
    def on_enter();
}

class navigator {
    private pile := new list<screen>();

    def open(next: screen) {
        pile.add(next);
        next.on_enter();
    }

    def replace(next: screen) {
        if(pile.size() > 0) { pile.pop_last(); }
        open(next);
    }

    /** back to the screen below; the last screen stays (there is nowhere to go back to) */
    def back() {
        if(pile.size() <= 1) { return; }
        pile.pop_last();
        pile.last().on_enter();
    }

    def current() : screen? {
        if(pile.size() == 0) { return null; }
        return pile.last();
    }

    def depth() : _int64 { return pile.size().value; }

    /** draw the screen on top */
    def draw(onto: display) {
        if(pile.size() == 0) { return; }
        draw_frame(onto, pile.last().body());
    }
}
