mod ui;

import ( std, controller.hardware );

/**
 * THE UI TOOLKIT, PART 1: a view, and where it goes
 *
 * A screen is DESCRIBED, not drawn by hand: you say what is on it and how the
 * pieces stand to each other, and the toolkit works out the pixels.
 *
 *      battery  := picture(icon_battery_3);
 *      altitude := text("ALT");
 *      speed    := text("42").size(2);
 *
 *      return relative()
 *          .add(battery.at_top().at_right())
 *          .add(altitude.below(battery).align_right(battery).margin_top(4))
 *          .add(speed.center());
 *
 * This is Android's RelativeLayout - "below that", "to the right of that",
 * "aligned with the parent's edge" - written the way Compose and SwiftUI
 * build a screen: views are ordinary values held in variables, and a screen is
 * a function that returns them. There are no view ids, no find_view_by_id and
 * no casts.
 *
 * WHERE A VIEW GOES is decided by its RELATIONS:
 *
 *      below(v) / above(v)             under / over another view
 *      right_of(v) / left_of(v)        beside another view
 *      align_left(v) ... align_bottom(v)    the same edge as another view
 *      at_left() at_right() at_top() at_bottom()    against an edge of the container
 *      center() center_across() center_down()       in the middle of the container
 *      margin(left, top, right, bottom), margin_top(n) ...    space around it
 *
 * A view with no relation in a direction sits at the container's left / top.
 *
 * HOW BIG A VIEW IS: as big as what it shows (FIT, the default), as big as
 * the container (FILL), or a number of pixels: `.width(30)`, `.fill_width()`.
 *
 * Every function that changes a view returns the view, so they chain.
 *
 *      Android comparison: android.view.View with RelativeLayout.LayoutParams.
 */
const FIT : _int64 = 0 - 1;             // as big as its content
const FILL : _int64 = 0 - 2;            // as big as the container

/** where a view's content sits inside its own width, when the view is wider than the content */
const ALIGN_START : _int64 = 0;
const ALIGN_MIDDLE : _int64 = 1;
const ALIGN_END : _int64 = 2;

class view {
    // ---- where it ended up (set by the layout; read by draw and by tests)
    x : _int64 = 0;
    y : _int64 = 0;
    wide : _int64 = 0;
    high : _int64 = 0;

    // ---- what was asked for
    wanted_width : _int64 = FIT;
    wanted_height : _int64 = FIT;
    visible : _int64 = true;
    content_align : _int64 = ALIGN_START;

    space_left : _int64 = 0;
    space_top : _int64 = 0;
    space_right : _int64 = 0;
    space_bottom : _int64 = 0;

    // ---- the relations (null: none)
    under : view? = null;               // below(v)
    over : view? = null;                // above(v)
    after : view? = null;               // right_of(v)
    before : view? = null;              // left_of(v)
    same_left : view? = null;
    same_right : view? = null;
    same_top : view? = null;
    same_bottom : view? = null;
    to_left_edge : _int64 = false;
    to_right_edge : _int64 = false;
    to_top_edge : _int64 = false;
    to_bottom_edge : _int64 = false;
    middle_across : _int64 = false;
    middle_down : _int64 = false;

    // ---- while a container lays its views out
    placed : _int64 = false;
    placing : _int64 = false;           // true while this view's place is being worked out (finds circles)

    // What every kind of view says about itself. (They are declared without a body: in Sharp
    // that is what lets a class below `override` them - a function with a body cannot be replaced.)

    /** how big the content is */
    def content_width() : _int64;
    def content_height() : _int64;

    /** draw at (x, y), `wide` x `high` */
    def draw(screen: display);

    def right() : _int64 { return x + wide; }
    def bottom() : _int64 { return y + high; }

    // ------------------------------------------------------------------ size

    def width(pixels: _int64) : view { wanted_width = pixels; return self; }
    def height(pixels: _int64) : view { wanted_height = pixels; return self; }
    def fill_width() : view { wanted_width = FILL; return self; }
    def fill_height() : view { wanted_height = FILL; return self; }
    def hide() : view { visible = false; return self; }
    def show_if(yes: _int64) : view { visible = yes; return self; }

    /** where the content sits inside a view wider than it: ALIGN_START, ALIGN_MIDDLE, ALIGN_END */
    def align_content(how: _int64) : view { content_align = how; return self; }

    // ------------------------------------------------------------------ relations

    def below(other: view) : view { under = other; return self; }
    def above(other: view) : view { over = other; return self; }
    def right_of(other: view) : view { after = other; return self; }
    def left_of(other: view) : view { before = other; return self; }
    def align_left(other: view) : view { same_left = other; return self; }
    def align_right(other: view) : view { same_right = other; return self; }
    def align_top(other: view) : view { same_top = other; return self; }
    def align_bottom(other: view) : view { same_bottom = other; return self; }

    def at_left() : view { to_left_edge = true; return self; }
    def at_right() : view { to_right_edge = true; return self; }
    def at_top() : view { to_top_edge = true; return self; }
    def at_bottom() : view { to_bottom_edge = true; return self; }
    def center_across() : view { middle_across = true; return self; }
    def center_down() : view { middle_down = true; return self; }
    def center() : view { middle_across = true; middle_down = true; return self; }

    // ------------------------------------------------------------------ space around it

    def margin(left: _int64, top: _int64, right: _int64, bottom: _int64) : view {
        space_left = left;
        space_top = top;
        space_right = right;
        space_bottom = bottom;
        return self;
    }
    def margin_left(pixels: _int64) : view { space_left = pixels; return self; }
    def margin_top(pixels: _int64) : view { space_top = pixels; return self; }
    def margin_right(pixels: _int64) : view { space_right = pixels; return self; }
    def margin_bottom(pixels: _int64) : view { space_bottom = pixels; return self; }
}
