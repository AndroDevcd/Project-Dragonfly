mod ui;

import ( std, controller.hardware, ui.icons );

/**
 * THE UI TOOLKIT, PART 4: a list to choose from
 *
 *      menu(lines, chosen)             every line, a marker in front of the chosen one
 *      menu(lines, chosen).rows(4)     at most four lines at a time: the list
 *                                      scrolls so that the chosen one is always shown
 *
 * The menu does not remember which line is chosen: the screen does, in a field
 * of its own, and hands the number in every time it describes itself. (That is
 * the Compose / SwiftUI rule: the state lives in one place, the views are made
 * from it.) Up and down are the screen's business too - it changes its number,
 * and the next frame shows it.
 */
const MENU_ROW_HEIGHT : _int64 = 10;                // 8 pixels of text and 2 of air
const MENU_TEXT_LEFT : _int64 = 16;                 // room for the marker (13 wide) in front of the text

class menu_view base view {
    lines : list<string>;
    chosen : _int64;
    shown_rows : _int64 = 0;                        // 0: all of them

    menu_view(lines: list<string>, chosen: _int64) {
        self->lines = lines;
        self->chosen = chosen;
    }

    def rows(count: _int64) : menu_view {
        shown_rows = count;
        return self;
    }

    private def row_count() : _int64 {
        all : _int64 = lines.size().value;
        if(shown_rows > 0 && shown_rows < all) { return shown_rows; }
        return all;
    }

    /** the first line that is shown: the list scrolls just far enough to show the chosen one */
    def first_shown() : _int64 {
        count : _int64 = row_count();
        if(chosen < count) { return 0; }
        return chosen - count + 1;
    }

    override def content_width() : _int64 {
        longest : _int64 = 0;
        for(i : _int64 = 0; i < lines.size(); i++) {
            if(sizeof(lines.at(i).data) > longest) { longest = sizeof(lines.at(i).data); }
        }
        return MENU_TEXT_LEFT + longest * GLYPH_WIDTH;
    }

    override def content_height() : _int64 {
        return row_count() * MENU_ROW_HEIGHT;
    }

    override def draw(screen: display) {
        first : _int64 = first_shown();
        for(row : _int64 = 0; row < row_count(); row++) {
            line : _int64 = first + row;
            if(line >= lines.size()) { return; }
            top : _int64 = y + row * MENU_ROW_HEIGHT;
            if(line == chosen) { screen.picture(x, top, icon_item_selector); }
            screen.text(x + MENU_TEXT_LEFT, top, 1, lines.at(line));
        }
    }
}

def menu(lines: list<string>, chosen: _int64) : menu_view { return new menu_view(lines, chosen); }
