mod ui;

import ( std, controller.hardware );

/**
 * THE UI TOOLKIT, PART 2: the views that show something
 *
 *      text("ALT")                 a word in the display's font
 *      text("42").size(2)          ... twice as big
 *      picture(icon_battery_3)     a small picture
 *      spacer(4, 4)                nothing: only takes room
 *
 * `text` and `picture` are functions that make the view, so a screen reads
 *      speed := text("42");
 * and not `new text_view(...)`.
 */

/** a word (or a line) in the display's font */
class text_view base view {
    value : string;
    scale : _int64 = 1;

    text_view(value: string) {
        self->value = value;
    }

    /** 1: 6 x 8 pixels a character; 2: 12 x 16; ... */
    def size(scale: _int64) : text_view {
        if(scale < 1) { scale = 1; }
        self->scale = scale;
        return self;
    }

    override def content_width() : _int64 { return sizeof(value.data) * GLYPH_WIDTH * scale; }
    override def content_height() : _int64 { return GLYPH_HEIGHT * scale; }

    override def draw(screen: display) {
        // a view wider than its text: the text sits at the start, the middle or the end of it
        left : _int64 = x;
        spare : _int64 = wide - content_width();
        if(spare > 0 && content_align == ALIGN_MIDDLE) { left = x + spare / 2; }
        if(spare > 0 && content_align == ALIGN_END) { left = x + spare; }

        // a view NARROWER than its text shows as many characters as fit (never half a character)
        shown : string = value;
        fits : _int64 = wide / (GLYPH_WIDTH * scale);
        if(fits < sizeof(value.data)) {
            if(fits <= 0) { return; }
            shown = new string(value.data!!, 0, fits);
        }
        screen.text(left, y, scale, shown);
    }
}

class picture_view base view {
    drawn : image;

    picture_view(drawn: image) {
        self->drawn = drawn;
    }

    override def content_width() : _int64 { return drawn.width; }
    override def content_height() : _int64 { return drawn.height; }

    override def draw(screen: display) {
        left : _int64 = x;
        spare : _int64 = wide - drawn.width;
        if(spare > 0 && content_align == ALIGN_MIDDLE) { left = x + spare / 2; }
        if(spare > 0 && content_align == ALIGN_END) { left = x + spare; }
        screen.picture(left, y, drawn);
    }
}

/** room and nothing else */
class spacer_view base view {
    private room_wide : _int64;
    private room_high : _int64;

    spacer_view(wide: _int64, high: _int64) {
        room_wide = wide;
        room_high = high;
    }

    override def content_width() : _int64 { return room_wide; }
    override def content_height() : _int64 { return room_high; }
    override def draw(screen: display) { }
}

def text(value: string) : text_view { return new text_view(value); }
def picture(drawn: image) : picture_view { return new picture_view(drawn); }
def spacer(wide: _int64, high: _int64) : spacer_view { return new spacer_view(wide, high); }
