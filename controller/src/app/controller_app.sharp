mod controller;

import ( std, link, link.hardware, link.protocol, link.messages, controller.hardware, controller.input, ui );

/**
 * THE CONTROLLER: the whole program, as one object that is stepped
 *
 *      app := new controller_app(devices);
 *      app.start(first_screen);
 *      for(;;) { app.step(); }
 *
 * Each step, in order:
 *
 *      1. the link does its work                frames in, acknowledgements, resends
 *      2. what the drone said goes into `state` telemetry, notices
 *      3. the connection is judged              state, signal bars, the light
 *      4. the settings are carried out          the flight mode is sent until the drone has it
 *      5. the buttons are read                  and handed to the screen that is shown
 *      6. a frame is drawn                      every FRAME_MS, from `state`
 *
 * Nothing waits and there are no threads: the old controller needed four
 * (ui, io, net, default) and locks between them because every part sat in a
 * loop of its own.
 *
 * THE SCREENS reach three things through the app: `state` (what to show),
 * `chosen` (the settings, to change them) and `screens` (to go somewhere).
 */
const FRAME_MS : _int64 = 33;                   // 30 frames a second
const LIGHT_BLINK_MS : _int64 = 500;            // the connecting light: half a second on, half off
const NOTICE_SHOWN_MS : _int64 = 4000;

const UP_BUTTON_PIN : _int64 = 28;
const DOWN_BUTTON_PIN : _int64 = 29;
const CONNECTING_LIGHT_PIN : _int64 = 27;
// The buttons' power: a pin kept on (3.3 V) for as long as the program runs, because the Pi has
// too few 3.3 V pins to go round. Both buttons take their positive side from it. wiringPi 25 is
// GPIO 26, physical pin 37 - beside the buttons' own pins 38 and 40.
const BUTTON_POWER_PIN : _int64 = 25;

/** everything the controller is made of */
class controller_devices {
    air : radio;
    time : clock;
    pins : gpio;
    panel : display;
    saved : settings_store;
    tuning : radio_control? = null;             // the radio's own settings, when it has them
    channels : channel_control? = null;         // the radio's channels, when it can change them

    controller_devices(air: radio, time: clock, pins: gpio, panel: display, saved: settings_store) {
        self->air = air;
        self->time = time;
        self->pins = pins;
        self->panel = panel;
        self->saved = saved;
    }
}

class controller_app {
    private devices : controller_devices;
    net : radio_link;
    state := new controller_state();
    chosen : settings;
    screens := new navigator();
    buttons : button_reader;

    private drawn_at : _int64 = 0 - 1;          // when the last frame was drawn
    private telemetry_at : _int64 = 0 - 1;      // when telemetry last arrived
    private mode_sent : _int64 = 0 - 1;         // the flight mode the drone was last told (-1: none yet)
    private mode_message : _int64 = 0 - 1;      // the id of the set_mode that is on its way (-1: none)
    private mode_wanted : _int64 = 0 - 1;       // ... and the mode it carries
    private power_set : _int64 = 0 - 1;
    private dim_set : _int64 = 0 - 1;

    frames_drawn : _int64 = 0;
    steps : _int64 = 0;                         // turns of the loop so far
    private started_at : _int64 = 0;
    report_buttons : _int64 = false;            // print every button event (the console on the Pi turns it on)

    private keep_running : _int64 = true;       // the main loop runs while this is true
    wants_power_off : _int64 = false;           // the pilot chose "power off" (not just "quit"): power the Pi down
    private jam_until : _int64 = 0 - 1;         // when the running jam ends (-1: not jamming)
    private jam_on_channel : _int64 = 0;        // the channel it is jamming

    keeper : channel_keeper? = null;            // the channel, when the radio can change it
    scanner : channel_scanner? = null;          // while the channels screen is open
    private channel_message : _int64 = 0 - 1;   // the set_channel on its way (-1: none)
    channel_wanted : _int64 = 0 - 1;            // ... and the channel it names

    controller_app(devices: controller_devices) {
        self->devices = devices;
        net = new radio_link(devices.air, devices.time);
        chosen = new settings(devices.saved);
        buttons = new button_reader(devices.pins, devices.time, UP_BUTTON_PIN, DOWN_BUTTON_PIN);
        devices.pins.set_output(CONNECTING_LIGHT_PIN);
        devices.pins.set_output(BUTTON_POWER_PIN);
        devices.pins.write(BUTTON_POWER_PIN, true);
        started_at = devices.time.now_ms();
        if(devices.channels != null) { keeper = new channel_keeper(devices.channels!!, net, devices.time); }
        net.connect();
    }

    /** show the first screen */
    def start(first: screen) {
        screens.open(first);
    }

    def now_ms() : _int64 { return devices.time.now_ms(); }

    def step() {
        steps++;
        now : _int64 = devices.time.now_ms();

        // WHILE JAMMING, nothing else is allowed to touch the radio. There is one radio: the
        // scanner's sense() hops it across channels to listen, and the link sends and receives on
        // its own channel - either one pulls the radio off the jam channel and tears the carrier
        // down, which is why a jam seemed to do nothing. During a jam the loop does only the jam,
        // the buttons and the screen; normal work resumes the moment it ends.
        if(is_jamming()) {
            run_jam(now);
            read_buttons();
            draw(now);
            return;
        }

        net.step();
        follow_channel_change(now);
        if(keeper != null && keeper!!.step()) { tell("lost the drone: back on channel " + RADIO_CHANNEL, now); }
        if(scanner != null) { scanner!!.step(); }
        run_jam(now);
        hear_drone(now);
        judge_connection(now);
        carry_out_settings();
        read_buttons();
        draw(now);
    }

    // ------------------------------------------------------------------ 2. what the drone said

    private def hear_drone(now: _int64) {
        for(;;) {
            heard := net.next();
            if(heard == null) { return; }
            m : message = heard!!;
            if(m.type == message_types.TELEMETRY) {
                reading := telemetry.from_message(m);
                if(reading == null) { continue; }
                state.has_telemetry = true;
                state.altitude_cm = reading!!.altitude_cm;
                state.speed_cm_s = reading!!.speed_cm_s;
                state.battery = reading!!.battery;
                state.drone_mode = reading!!.mode;
                telemetry_at = now;
            } else if(m.type == message_types.NOTICE) {
                told := notice.from_message(m);
                if(told == null) { continue; }
                state.notice_text = told!!.text;
                state.notice_level = told!!.level;
                state.notice_until = now + NOTICE_SHOWN_MS;
            }
        }
    }

    // ------------------------------------------------------------------ 3. the connection

    private def judge_connection(now: _int64) {
        state.link_state = net.state();

        // the bars: how fresh the drone's last telemetry is (it sends five a second)
        bars : _int64 = 0;
        if(net.is_connected()) {
            bars = 1;
            if(telemetry_at >= 0) {
                age : _int64 = now - telemetry_at;
                if(age < 400) { bars = 4; }
                else if(age < 700) { bars = 3; }
                else if(age < 1000) { bars = 2; }
            }
        } else {
            state.has_telemetry = false;        // old numbers are not shown as if they were current
        }
        state.signal = bars;

        if(state.notice_until > 0 && now >= state.notice_until) {
            state.notice_text = "";
            state.notice_until = 0;
        }

        // the clock: minutes since midnight, in the pilot's time
        // (`/` between whole numbers gives a decimal in Sharp; an `_int64` variable makes it whole again)
        minutes : _int64 = now / 60000;
        minutes = minutes + chosen.utc_offset * 60;
        minutes = ((minutes % 1440) + 1440) % 1440;
        state.clock_text = clock_text_of(minutes);

        // the light: steady while connected, blinking while looking for the drone
        lit : _int64 = true;
        if(!net.is_connected()) {
            blinks : _int64 = now / LIGHT_BLINK_MS;
            lit = (blinks % 2) == 0;
        }
        devices.pins.write(CONNECTING_LIGHT_PIN, lit);
    }

    // ------------------------------------------------------------------ 4. the settings

    private def carry_out_settings() {
        // the screen's brightness and the radio's power: told to the hardware when they change
        dim : _int64 = chosen.dim_screen ? 1 : 0;
        if(dim != dim_set) {
            devices.panel.dim(chosen.dim_screen);
            dim_set = dim;
        }
        if(chosen.radio_power != power_set && devices.tuning != null) {
            devices.tuning!!.set_power(chosen.radio_power);
            power_set = chosen.radio_power;
        }

        // The flight mode is the drone's to obey: it is SENT, reliably, and counts as told only
        // when the drone acknowledged it. A message that failed (the drone was out of reach) is
        // sent again; so is the mode after the connection came back, because a drone that was
        // restarted is in normal mode again.
        if(!net.is_connected()) {
            mode_sent = 0 - 1;
            mode_message = 0 - 1;
            return;
        }
        if(mode_message >= 0) {
            if(net.is_delivered(mode_message)) {
                mode_sent = mode_wanted;
                mode_message = 0 - 1;
            } else if(net.has_failed(mode_message)) {
                mode_message = 0 - 1;
            }
            return;
        }
        if(mode_sent != chosen.flight_mode) {
            mode_wanted = chosen.flight_mode;
            mode_message = net.send(new set_mode(mode_wanted).to_message());
        }
    }

    /** true while the drone has not acknowledged the flight mode that is chosen */
    def mode_is_pending() : _int64 {
        return mode_sent != chosen.flight_mode;
    }

    // ------------------------------------------------------------------ 5. the buttons

    private def read_buttons() {
        buttons.step();
        for(;;) {
            pressed : _int64 = buttons.next();
            if(pressed == BUTTON_NONE) { return; }
            if(report_buttons) { println("button: " + button_name(pressed)); }
            shown := screens.current();
            if(shown != null) { shown!!.on_button(pressed); }
        }
    }

    // ------------------------------------------------------------------ 6. a frame

    private def draw(now: _int64) {
        if(drawn_at >= 0 && now - drawn_at < FRAME_MS) { return; }
        drawn_at = now;
        screens.draw(devices.panel);
        frames_drawn++;
    }

    // ------------------------------------------------------------------ 7. the radio channel

    /** the channel the radio is on */
    def channel() : _int64 {
        if(keeper == null) { return RADIO_CHANNEL; }
        return keeper!!.current();
    }

    def can_change_channel() : _int64 { return keeper != null; }

    /**
     * JAM: disturb a channel for a while, then stop by itself. The channel and how long are
     * settings (settings.jam_channel, settings.jam_seconds); 0 seconds means jamming is off.
     * The radio does it in short bursts, one a step (run_jam), so the screen still updates. It
     * jams THIS controller's own radio - the drone has its own, separate jammer.
     */
    def start_jam() : _int64 {
        at : _int64 = now_ms();
        if(devices.tuning == null) { tell("this radio cannot jam", at); return false; }
        if(chosen.jam_seconds <= 0) { tell("jam is off: set a time in settings", at); return false; }
        jam_on_channel = chosen.jam_channel;
        jam_until = at + chosen.jam_seconds * 1000;
        return true;
    }

    /** stop a jam early (the cancel on the jam screen) */
    def stop_jam() {
        if(jam_until >= 0) {
            jam_until = 0 - 1;
            tell("jam cancelled", now_ms());
        }
    }

    def is_jamming() : _int64 { return jam_until >= 0; }
    def jam_channel() : _int64 { return jam_on_channel; }

    /** whole seconds left in the running jam (0 when none), for the countdown */
    def jam_seconds_left() : _int64 {
        if(jam_until < 0) { return 0; }
        left : _int64 = jam_until - now_ms();
        if(left < 0) { left = 0; }
        return (left + 999) / 1000;
    }

    private def run_jam(now: _int64) {
        if(jam_until < 0) { return; }
        if(now >= jam_until) {
            jam_until = 0 - 1;
            tell("jam done", now);
            return;
        }
        if(devices.tuning != null) { devices.tuning!!.jam(jam_on_channel); }
    }

    // ------------------------------------------------------------------ stopping and powering off

    /** the main loop asks this every turn (controller/main) */
    def is_running() : _int64 { return keep_running; }

    /** stop the program the tidy way (`q` at the console) */
    def request_stop() { keep_running = false; }

    /** stop, and power the Raspberry Pi down (the "Power off" line in the settings) */
    def power_off() {
        wants_power_off = true;
        keep_running = false;
    }
    def channel_is_pending() : _int64 { return channel_message >= 0; }

    /**
     * MOVE BOTH SIDES TO `channel`.
     *
     * The drone is told on the channel both are on now. It moves as soon as its link has
     * acknowledged the message; THIS side moves only when that acknowledgement has arrived
     * (follow_channel_change). Not before: until then the drone may not have the message at all.
     *
     * The one thing nobody can know is whether the drone's acknowledgement got through: if it
     * was lost, the drone has moved and the controller has not. Then neither hears the other,
     * and both go back to the home channel after FALLBACK_MS (link/channels.sharp).
     */
    def change_channel(channel: _int64) : _int64 {
        if(keeper == null || channel_message >= 0) { return false; }
        if(channel < 0 || channel > 125 || channel == keeper!!.current()) { return false; }
        if(!net.is_connected()) {
            tell("no drone to tell: the channel stays " + keeper!!.current(), devices.time.now_ms());
            return false;
        }
        channel_wanted = channel;
        channel_message = net.send(new set_channel(channel).to_message());
        return true;
    }

    private def follow_channel_change(now: _int64) {
        if(channel_message < 0) { return; }
        if(net.is_delivered(channel_message)) {
            channel_message = 0 - 1;
            keeper!!.move_to(channel_wanted);
            tell("moved to channel " + channel_wanted, now);
        } else if(net.has_failed(channel_message)) {
            channel_message = 0 - 1;
            tell("the drone did not answer: the channel stays " + keeper!!.current(), now);
        }
    }

    /** the scanner runs only while someone looks at it: it takes the radio's time */
    def start_scan() {
        if(devices.channels != null && scanner == null) { scanner = new channel_scanner(devices.channels!!); }
    }

    def stop_scan() { scanner = null; }

    /** a line for the pilot at the bottom of the screen, for a few seconds */
    def tell(text: string, now: _int64) {
        state.notice_text = text;
        state.notice_level = NOTICE_INFO;
        state.notice_until = now + NOTICE_SHOWN_MS;
    }

    // ------------------------------------------------------------------ 8. what the console can ask

    /** the buttons' pins as the Pi reads them right now: `pins` at the console */
    def pins_text() : string {
        return "up (pin 38): " + devices.pins.read(UP_BUTTON_PIN)
             + "   down (pin 40): " + devices.pins.read(DOWN_BUTTON_PIN)
             + "   buttons' power (pin 37): " + devices.pins.read(BUTTON_POWER_PIN)
             + "   (1 = 3.3 V)";
    }

    /** is the loop going round, and how fast: `status` at the console */
    def status_text() : string {
        now : _int64 = devices.time.now_ms();
        seconds : _int64 = (now - started_at) / 1000;
        per_second : _int64 = 0;
        if(seconds > 0) { per_second = steps / seconds; }
        return "running " + seconds + " s, " + steps + " turns of the loop (" + per_second + " a second), "
             + frames_drawn + " frames drawn, " + screens.depth() + " screen(s) open";
    }

    // ------------------------------------------------------------------ 9. the end

    /**
     * LEAVE THE HARDWARE TIDY: the screen blank, the light off.
     *
     * Called once, after the last step(), when the program is told to stop (`q` at the console -
     * controller/main). Without it the screen keeps showing its last picture - an altitude, a
     * "connected" - for as long as it has power, which is a lie from then on.
     */
    def shut_down() {
        devices.panel.clear();
        devices.panel.show();
        devices.pins.write(CONNECTING_LIGHT_PIN, false);
        devices.pins.write(BUTTON_POWER_PIN, false);
    }
}
