mod controller.hardware;

import ( std );

/**
 * THE DISPLAY: a 128 x 64 screen of on/off pixels (the SSD1306 OLED)
 *
 * A frame is drawn by clearing, drawing text and pictures, and then showing:
 * nothing is visible until `show()`.
 *
 *      screen.clear();
 *      screen.text(0, 0, 1, "12:30");
 *      screen.picture(112, 0, battery_icon);
 *      screen.show();
 *
 * Text is the display's own font: every character is 6 pixels wide and 8
 * high at size 1, twice that at size 2, and so on (GLYPH_WIDTH, GLYPH_HEIGHT).
 * The UI computes with those numbers; it never asks the display how wide a
 * word is.
 *
 *      real hardware      ssd1306_display      C++ behind it (pi_devices.sharp)
 *      a test on a PC     fake_display         remembers what was drawn where
 */
const DISPLAY_WIDTH : _int64 = 128;
const DISPLAY_HEIGHT : _int64 = 64;
const GLYPH_WIDTH : _int64 = 6;
const GLYPH_HEIGHT : _int64 = 8;

/** what a pixel of a picture does to the screen */
const PIXEL_KEEP : _int64 = 0;          // leaves what is there
const PIXEL_OFF : _int64 = 1;           // dark
const PIXEL_ON : _int64 = 2;            // lit
const PIXEL_INVERT : _int64 = 3;        // the opposite of what is there

/** a small picture: `width` x `height` pixels, row by row, each a PIXEL_ value */
class image {
    width : _int64;
    height : _int64;
    pixels : _uint8[];
    name : string;                      // for tests and logs: "battery_2"

    image(name: string, width: _int64, height: _int64, pixels: _uint8[]) {
        self->name = name;
        self->width = width;
        self->height = height;
        self->pixels = pixels;
    }
}

interface display {
    def clear();
    /** `value` at (x, y) - its top left corner - in the display's font at `size` */
    def text(x: _int64, y: _int64, size: _int64, value: string);
    def picture(x: _int64, y: _int64, drawn: image);
    /** put what was drawn since clear() on the screen */
    def show();
    /** true: low brightness */
    def dim(yes: _int64);
}

// ---------------------------------------------------------------------------
// the fake: remembers what was drawn, so a test can ask "where is the speed?"
// ---------------------------------------------------------------------------

/** one thing that was drawn in a frame */
class drawn_item {
    is_text : _int64;
    x : _int64;
    y : _int64;
    width : _int64;
    height : _int64;
    what : string;                      // the text, or the picture's name
    size : _int64 = 1;

    drawn_item(is_text: _int64, x: _int64, y: _int64, width: _int64, height: _int64, what: string) {
        self->is_text = is_text;
        self->x = x;
        self->y = y;
        self->width = width;
        self->height = height;
        self->what = what;
    }

    def right() : _int64 { return x + width; }
    def bottom() : _int64 { return y + height; }
}

class fake_display : display {
    private drawing := new list<drawn_item>();          // the frame being drawn
    shown := new list<drawn_item>();                    // the frame that is "on the screen"
    frames : _int64 = 0;
    is_dim : _int64 = false;

    override def clear() {
        drawing = new list<drawn_item>();
    }

    override def text(x: _int64, y: _int64, size: _int64, value: string) {
        item := new drawn_item(true, x, y, sizeof(value.data) * GLYPH_WIDTH * size, GLYPH_HEIGHT * size, value);
        item.size = size;
        drawing.add(item);
    }

    override def picture(x: _int64, y: _int64, drawn: image) {
        drawing.add(new drawn_item(false, x, y, drawn.width, drawn.height, drawn.name));
    }

    override def show() {
        shown = drawing;
        frames++;
    }

    override def dim(yes: _int64) {
        is_dim = yes;
    }

    /** the text or picture called `what` in the frame on the screen; null when it is not there */
    def find(what: string) : drawn_item? {
        for(i : _int64 = 0; i < shown.size(); i++) {
            if(shown.at(i).what == what) { return shown.at(i); }
        }
        return null;
    }

    def has(what: string) : _int64 {
        return find(what) != null;
    }

    /** true when anything on the screen reaches outside it */
    def anything_off_screen() : _int64 {
        for(i : _int64 = 0; i < shown.size(); i++) {
            item := shown.at(i);
            if(item.x < 0 || item.y < 0 || item.right() > DISPLAY_WIDTH || item.bottom() > DISPLAY_HEIGHT) { return true; }
        }
        return false;
    }

    /** the frame as lines of text, for a person to read: "  0,  0  12:30" */
    def describe() : string {
        text := "";
        for(i : _int64 = 0; i < shown.size(); i++) {
            item := shown.at(i);
            text = text + "  (" + item.x + ", " + item.y + ") " + item.width + "x" + item.height + "  ";
            if(item.is_text) { text = text + "\"" + item.what + "\"\n"; }
            else { text = text + "[" + item.what + "]\n"; }
        }
        return text;
    }
}
