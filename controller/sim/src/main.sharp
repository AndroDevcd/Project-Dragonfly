mod dragonfly.sim;

import ( std.guikit.* );

/**
 * THE CONTROLLER SCREEN, SIMULATED - at the real size of the display.
 *
 * The display is a 2" ST7789V: 320 x 240 pixels, mounted LANDSCAPE (the long
 * side flat). gui.run opens a window of exactly that many pixels, so this
 * window is the real screen pixel for pixel. Click the mode chip between the
 * sticks; tap a notice to close it.
 *
 *      sharpc -P controller/sim
 *      sharp controller/sim/build/outputs/sim
 *
 *      flight_model.sharp     THE LOGIC: the readings, the fake feed, the mode
 *      flight_screen.sharp    THE SCREEN: reads the model, decides nothing
 *      parts.sharp            the small pieces: battery, signal, stick, tiles, chip
 *      look.sharp             the colours (Material 3, dark)
 */
const SCREEN_WIDTH : _int64 = 320;
const SCREEN_HEIGHT : _int64 = 240;

def main() {
    gui.use_theme(material_dark());
    gui.run("Dragonfly", SCREEN_WIDTH, SCREEN_HEIGHT, flight_screen());
}
