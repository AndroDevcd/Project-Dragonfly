mod main;

import ( std, std.io, platform, link.hardware, controller, controller.gui, std.guikit.* );

/**
 * THE CONTROLLER, ON THE RASPBERRY PI
 *
 *      sharpc -P controller                        builds the program and its C++ library
 *      sharp controller/build/outputs/controller
 *
 * The UI is a guikit app (controller/src/gui): it opens a 320 x 240 window -
 * the size of the real 2" display - steps the controller on a timer and draws
 * the flight screen and the menus from what the controller knows. Closing the
 * window stops it; "Power off" in the settings stops it and powers the Pi down.
 *
 *      ... controller virtual                       also draw on-screen buttons,
 *                                                   to drive it with a mouse on a PC
 *
 * This file only puts the real hardware together and hands the controller to
 * the GUI; the logic is `controller_app` (controller/src/app), and the screens
 * are controller/src/gui. The simulator (simulator/) runs the same GUI with a
 * drone and a radio in memory, so a change can be seen on a PC first.
 */
def main(args: string[]) : int {
    try {
        load_library(program_folder() + "/dragonfly");

        // The radio is started BEFORE the pins on purpose. wiringPiSetup() (pi_gpio) and the RF24
        // library both take over the Pi's GPIO; bringing wiringPi up first was leaving the radio's
        // begin() unable to init - the chip answered on SPI but radio_begin() returned 0. Starting
        // the radio first, then wiringPi, keeps both working.
        air := new nrf24_radio(true, 0);
        pins := new pi_gpio();
        devices := new controller_devices(air, new system_clock(), pins,
                                          new file_store(program_folder() + "/settings.prefs"));
        devices.tuning = air;
        devices.channels = air;
        devices.jammer = air;

        app := new controller_app(devices);
        app.report_buttons = true;          // every button event is printed: "button: long press"

        controller_host.app = app;
        // the on-screen buttons are on by default (controller_host); `real` turns them off for a
        // Pi with its two buttons wired, `virtual` forces them on
        if(has_arg(args, "real")) { controller_host.virtual = 0; }
        else if(has_arg(args, "virtual")) { controller_host.virtual = 1; }

        gui.use_theme(material_dark());
        gui.frame_rate(FRAME_RATE);
        gui.run("Dragonfly", SCREEN_W, window_height(), new controller_app_root());

        app.shut_down();
        if(app.wants_power_off) {
            println("dragonfly controller: powering down");
            sys("poweroff");                // the Pi turns off (the program runs as root); on a PC this is just a command
        } else {
            println("dragonfly controller: stopped");
        }
    } catch(problem: hardware_exception) {
        println("dragonfly controller: " + problem.get_message());
        return 1;
    }
    return 0;
}

/** was the program started with this word? */
def has_arg(args: string[], want: string) : _int64 {
    for(i : _int64 = 0; i < sizeof(args); i++) {
        if(args[i] == want) { return 1; }
    }
    return 0;
}
