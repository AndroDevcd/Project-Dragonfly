mod main;

import ( std, std.io, link, link.hardware, controller, controller.gui,
         drone, drone.hardware, std.guikit.* );

/**
 * THE SIMULATOR: the controller and the drone, running together on a PC.
 *
 *      sharpc -P simulator
 *      sharp simulator/build/outputs/simulator
 *
 * Both real programs run in this one process, on simulated hardware: a radio in
 * memory, buttons you press on screen, a drone that climbs when it is given
 * throttle. The controller's GUI opens exactly as it does on the real display
 * (320 x 240), with the four on-screen buttons under it - drive it with the
 * mouse. The flight readings are the drone's, through the same link and the
 * same messages the real one uses.
 *
 * Use it to see a change working before it goes anywhere near a Raspberry Pi.
 */
def main() : int {
    air := new radio_pair();
    time := new system_clock();
    pins := new fake_gpio();

    app := new controller_app(new controller_devices(air.first, time, pins, new memory_store()));

    ground := new fake_distance_sensor();
    thrust := new fake_motors();
    computer := new flight_computer(new drone_devices(air.second, time, ground, thrust, new fake_battery()));

    // the pretend world, stepped each GUI tick: the drone hovers at about a metre and a half and
    // sinks in failsafe. `height` is tenths of a centimetre so the climb is gentle.
    height := new _int64[1];
    world := { ->
        if(computer.state.failsafe) { height[0] = height[0] - 3; }
        else if(height[0] < 1500) { height[0] = height[0] + 5; }
        if(height[0] < 0) { height[0] = 0; }
        ground.cm = height[0] / 10;
        computer.step();
    };

    controller_host.app = app;
    controller_host.on_tick = world;
    controller_host.virtual = 1;

    gui.use_theme(material_dark());
    gui.frame_rate(FRAME_RATE);         // as on the real controller
    gui.run("Dragonfly (sim)", SCREEN_W, window_height(), new controller_app_root());
    return 0;
}
